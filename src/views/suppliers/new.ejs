<div class="max-w-2xl mx-auto space-y-6">
  <div>
    <a href="/suppliers" class="inline-flex items-center text-xs text-slate-500 hover:text-slate-800 mb-1">
      <i data-lucide="arrow-left" class="w-3.5 h-3.5 mr-1"></i>
      Back to Suppliers Directory
    </a>
    <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Add New Supplier</h1>
    <p class="text-slate-500 text-xs">Record contact person, payment terms, and vendor communication info.</p>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="p-3.5 rounded-xl bg-red-50 border border-red-200 text-red-600 text-xs flex items-center">
      <i data-lucide="alert-circle" class="w-4 h-4 mr-2 flex-shrink-0"></i>
      <span><%= error %></span>
    </div>
  <% } %>

  <div class="bg-white rounded-2xl border border-slate-200/80 shadow-2xs p-6">
    <form action="/suppliers" method="POST" class="space-y-4">
      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">Company / Supplier Name *</label>
        <input type="text" name="name" required placeholder="e.g. Acme Wholesale Distributors"
          value="<%= typeof data !== 'undefined' && data.name ? data.name : '' %>"
          class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs focus:outline-none focus:ring-1 focus:ring-blue-500 transition">
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Contact Person</label>
          <input type="text" name="contactPerson" placeholder="John Doe"
            value="<%= typeof data !== 'undefined' && data.contactPerson ? data.contactPerson : '' %>"
            class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs focus:outline-none focus:ring-1 focus:ring-blue-500 transition">
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Email Address</label>
          <input type="email" name="email" placeholder="orders@acmedist.com"
            value="<%= typeof data !== 'undefined' && data.email ? data.email : '' %>"
            class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs focus:outline-none focus:ring-1 focus:ring-blue-500 transition">
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Phone Number</label>
          <input type="text" name="phone" placeholder="+1 (555) 019-2834"
            value="<%= typeof data !== 'undefined' && data.phone ? data.phone : '' %>"
            class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs focus:outline-none focus:ring-1 focus:ring-blue-500 transition">
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Payment Terms</label>
          <input type="text" name="paymentTerms" placeholder="Net 30, COD, Due on Receipt"
            value="<%= typeof data !== 'undefined' && data.paymentTerms ? data.paymentTerms : 'Net 30' %>"
            class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs focus:outline-none focus:ring-1 focus:ring-blue-500 transition">
        </div>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">Physical Address</label>
        <textarea name="address" rows="2" placeholder="Warehouse address, City, Country"
          class="w-full px-3.5 py-2 rounded-xl border border-slate-200 text-xs focus:outline-none focus:ring-1 focus:ring-blue-500 transition"><%= typeof data !== 'undefined' && data.address ? data.address : '' %></textarea>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">Internal Notes</label>
        <textarea name="notes" rows="2" placeholder="Lead times, minimum order quantities, return policy notes..."
          class="w-full px-3.5 py-2 rounded-xl border border-slate-200 text-xs focus:outline-none focus:ring-1 focus:ring-blue-500 transition"><%= typeof data !== 'undefined' && data.notes ? data.notes : '' %></textarea>
      </div>

      <div class="pt-3 border-t border-slate-100 flex items-center justify-end space-x-3">
        <a href="/suppliers" class="px-4 py-2 text-xs font-medium text-slate-600 hover:text-slate-800">Cancel</a>
        <button type="submit" class="px-5 py-2.5 rounded-xl font-semibold text-xs text-white shadow-sm transition hover:opacity-95" style="background-color: <%= brandColor %>;">
          Save Supplier
        </button>
      </div>
    </form>
  </div>
</div>

