<div class="space-y-6">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Products Catalog</h1>
      <p class="text-slate-500 text-xs mt-1">
        Manage SKUs, dynamic custom attributes, and stock quantities.
      </p>
    </div>
    <div class="flex items-center space-x-2.5">
      <a href="/settings/custom-fields" class="inline-flex items-center px-3 py-2 rounded-xl border border-slate-200 bg-white text-xs font-medium text-slate-700 hover:bg-slate-50 shadow-2xs transition">
        <i data-lucide="sliders-horizontal" class="w-4 h-4 mr-1.5 text-indigo-500"></i>
        Configure Fields (<%= currentStore.customFields ? currentStore.customFields.length : 0 %>)
      </a>
      <a href="/products/new" class="inline-flex items-center px-3.5 py-2 rounded-xl text-xs font-semibold text-white shadow-xs transition hover:opacity-95" style="background-color: <%= brandColor %>;">
        <i data-lucide="plus" class="w-4 h-4 mr-1.5"></i>
        Add Product
      </a>
    </div>
  </div>

  <!-- Search & Filter Controls -->
  <div class="bg-white p-4 rounded-2xl border border-slate-200/80 shadow-2xs">
    <form action="/products" method="GET" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3">
      <!-- Search Input -->
      <div class="lg:col-span-2 relative">
        <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
          <i data-lucide="search" class="w-4 h-4"></i>
        </span>
        <input type="text" name="q" placeholder="Search by name, SKU, or barcode..." value="<%= filters.q || '' %>"
          class="w-full pl-9 pr-4 py-2 rounded-xl border border-slate-200 text-xs focus:outline-none focus:ring-1 focus:ring-blue-500 transition">
      </div>

      <!-- Category Filter -->
      <div>
        <select name="category" onchange="this.form.submit()"
          class="w-full px-3 py-2 rounded-xl border border-slate-200 text-xs focus:outline-none focus:ring-1 focus:ring-blue-500 transition text-slate-700">
          <option value="">All Categories</option>
          <% categories.forEach(cat => { %>
            <option value="<%= cat._id %>" <%= filters.category == cat._id.toString() ? 'selected' : '' %>>
              <%= cat.name %>
            </option>
          <% }) %>
        </select>
      </div>

      <!-- Stock Status Filter -->
      <div>
        <select name="stockStatus" onchange="this.form.submit()"
          class="w-full px-3 py-2 rounded-xl border border-slate-200 text-xs focus:outline-none focus:ring-1 focus:ring-blue-500 transition text-slate-700">
          <option value="">All Stock Levels</option>
          <option value="in_stock" <%= filters.stockStatus === 'in_stock' ? 'selected' : '' %>>In Stock (>0)</option>
          <option value="low" <%= filters.stockStatus === 'low' ? 'selected' : '' %>>Low Stock Alert</option>
          <option value="out" <%= filters.stockStatus === 'out' ? 'selected' : '' %>>Out of Stock (0)</option>
        </select>
      </div>

      <!-- Submit / Reset -->
      <div class="flex items-center space-x-2">
        <button type="submit" class="flex-1 py-2 px-3 rounded-xl bg-slate-900 text-white text-xs font-semibold hover:bg-slate-800 transition">
          Filter
        </button>
        <% if (filters.q || filters.category || filters.stockStatus) { %>
          <a href="/products" class="py-2 px-3 rounded-xl border border-slate-200 text-slate-600 text-xs hover:bg-slate-50 transition" title="Clear Filters">
            <i data-lucide="x" class="w-4 h-4"></i>
          </a>
        <% } %>
      </div>
    </form>
  </div>

  <!-- Products Table with Dynamic Custom Field Columns -->
  <div class="bg-white rounded-2xl border border-slate-200/80 shadow-2xs overflow-hidden">
    <% if (products && products.length > 0) { %>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="bg-slate-50 text-slate-500 uppercase tracking-wider text-[10px] border-b border-slate-100">
            <tr>
              <th class="py-3 px-4">Product / SKU</th>
              <th class="py-3 px-3">Category</th>
              <th class="py-3 px-3 text-right">Cost</th>
              <th class="py-3 px-3 text-right">Price</th>
              <th class="py-3 px-3 text-center">Stock</th>

              <!-- Dynamically Render Store's Custom Field Columns -->
              <% tableCustomFields.forEach(field => { %>
                <th class="py-3 px-3 text-slate-600">
                  <span class="inline-flex items-center gap-1" title="<%= field.description %>">
                    <%= field.label %>
                    <i data-lucide="sparkle" class="w-2.5 h-2.5 text-indigo-400"></i>
                  </span>
                </th>
              <% }) %>

              <th class="py-3 px-4 text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% products.forEach(p => { %>
              <tr class="hover:bg-slate-50/70 transition">
                <!-- Product / SKU -->
                <td class="py-3 px-4">
                  <div class="flex items-center space-x-3">
                    <div class="w-8 h-8 rounded-lg bg-slate-100 border border-slate-200 flex items-center justify-center text-slate-400 font-mono text-xs">
                      <i data-lucide="package" class="w-4 h-4"></i>
                    </div>
                    <div>
                      <a href="/products/<%= p._id %>" class="font-bold text-slate-900 hover:text-blue-600 block">
                        <%= p.name %>
                      </a>
                      <div class="flex items-center space-x-2 text-[11px] text-slate-400 font-mono">
                        <span>SKU: <%= p.sku %></span>
                        <% if (p.barcode) { %>
                          <span>• Barcode: <%= p.barcode %></span>
                        <% } %>
                      </div>
                    </div>
                  </div>
                </td>

                <!-- Category -->
                <td class="py-3 px-3">
                  <% if (p.category) { %>
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold" style="background-color: <%= p.category.color %>18; color: <%= p.category.color %>;">
                      <%= p.category.name %>
                    </span>
                  <% } else { %>
                    <span class="text-slate-400">-</span>
                  <% } %>
                </td>

                <!-- Cost Price -->
                <td class="py-3 px-3 text-right text-slate-500 font-medium">
                  <%= formatMoney(p.costPrice) %>
                </td>

                <!-- Selling Price -->
                <td class="py-3 px-3 text-right font-bold text-slate-900">
                  <%= formatMoney(p.sellingPrice) %>
                </td>

                <!-- Current Stock Badge -->
                <td class="py-3 px-3 text-center">
                  <% if (p.currentStock <= 0) { %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-bold bg-red-100 text-red-700">
                      0 <%= p.unit %> (Out)
                    </span>
                  <% } else if (p.currentStock <= p.reorderLevel) { %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-bold bg-amber-100 text-amber-800" title="At or below reorder level <%= p.reorderLevel %>">
                      <i data-lucide="alert-triangle" class="w-3 h-3 mr-1"></i>
                      <%= p.currentStock %> <%= p.unit %>
                    </span>
                  <% } else { %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-medium bg-emerald-100 text-emerald-800">
                      <%= p.currentStock %> <%= p.unit %>
                    </span>
                  <% } %>
                </td>

                <!-- Dynamically Rendered Custom Field Values -->
                <% tableCustomFields.forEach(field => { %>
                  <td class="py-3 px-3 text-slate-700">
                    <% const val = p.customFields ? p.customFields[field.key] : null; %>
                    <% if (field.type === 'boolean') { %>
                      <% if (val === true || val === 'true') { %>
                        <span class="inline-flex items-center text-emerald-600 font-semibold text-[11px]">
                          <i data-lucide="check" class="w-3.5 h-3.5 mr-0.5"></i> Yes
                        </span>
                      <% } else { %>
                        <span class="text-slate-400 text-[11px]">No</span>
                      <% } %>
                    <% } else if (field.type === 'date') { %>
                      <span class="text-[11px] font-mono <%= val && new Date(val) < new Date() ? 'text-red-600 font-bold' : 'text-slate-600' %>">
                        <%= formatDate(val) %>
                      </span>
                    <% } else { %>
                      <span class="text-[11px]"><%= val || '-' %></span>
                    <% } %>
                  </td>
                <% }) %>

                <!-- Actions -->
                <td class="py-3 px-4 text-right whitespace-nowrap">
                  <div class="flex items-center justify-end space-x-1.5">
                    <a href="/products/<%= p._id %>/barcode" target="_blank" title="Print Barcode Label" class="p-1.5 rounded-lg text-slate-400 hover:text-slate-700 hover:bg-slate-100">
                      <i data-lucide="printer" class="w-3.5 h-3.5"></i>
                    </a>
                    <a href="/stock/adjust?productId=<%= p._id %>" title="Adjust Stock" class="p-1.5 rounded-lg text-slate-400 hover:text-slate-700 hover:bg-slate-100">
                      <i data-lucide="sliders" class="w-3.5 h-3.5"></i>
                    </a>
                    <a href="/products/<%= p._id %>/edit" title="Edit" class="p-1.5 rounded-lg text-slate-400 hover:text-blue-600 hover:bg-slate-100">
                      <i data-lucide="edit-3" class="w-3.5 h-3.5"></i>
                    </a>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <div class="px-4 py-3 border-t border-slate-100 text-xs text-slate-500 bg-slate-50/50 flex justify-between items-center">
        <span>Showing <%= products.length %> items in catalog</span>
        <span>Custom attributes dynamically managed per store</span>
      </div>
    <% } else { %>
      <div class="text-center py-12 px-4">
        <div class="w-12 h-12 bg-slate-100 rounded-2xl flex items-center justify-center mx-auto text-slate-400 mb-3">
          <i data-lucide="package-search" class="w-6 h-6"></i>
        </div>
        <h3 class="text-sm font-bold text-slate-800">No products found</h3>
        <p class="text-xs text-slate-500 max-w-sm mx-auto mt-1 mb-4">
          Try clearing your filters or add your first product with customized attributes.
        </p>
        <a href="/products/new" class="inline-flex items-center px-4 py-2 rounded-xl text-xs font-semibold text-white transition" style="background-color: <%= brandColor %>;">
          <i data-lucide="plus" class="w-4 h-4 mr-1.5"></i>
          Add First Product
        </a>
      </div>
    <% } %>
  </div>
</div>

