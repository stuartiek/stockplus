<div class="max-w-4xl mx-auto space-y-6">
  <!-- Header -->
  <div class="flex items-center justify-between">
    <div>
      <a href="/products/<%= product._id %>" class="inline-flex items-center text-xs text-slate-500 hover:text-slate-800 mb-1">
        <i data-lucide="arrow-left" class="w-3.5 h-3.5 mr-1"></i>
        Back to <%= product.name %>
      </a>
      <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Edit Product</h1>
      <p class="text-slate-500 text-xs">SKU: <span class="font-mono text-slate-700"><%= product.sku %></span></p>
    </div>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="p-3.5 rounded-xl bg-red-50 border border-red-200 text-red-600 text-xs flex items-center">
      <i data-lucide="alert-circle" class="w-4 h-4 mr-2 flex-shrink-0"></i>
      <span><%= error %></span>
    </div>
  <% } %>

  <form action="/products/<%= product._id %>?_method=PUT" method="POST" class="space-y-6">
    <!-- Card 1: Core Details -->
    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-2xs p-6 space-y-4">
      <h2 class="text-xs font-semibold uppercase tracking-wider text-slate-500 flex items-center">
        <i data-lucide="info" class="w-3.5 h-3.5 mr-1.5 text-blue-500"></i>
        Core Product Information
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="md:col-span-2">
          <label class="block text-xs font-semibold text-slate-700 mb-1">Product Name *</label>
          <input type="text" name="name" required value="<%= product.name %>"
            class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs focus:outline-none focus:ring-1 focus:ring-blue-500 transition">
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">SKU (Read Only)</label>
          <input type="text" disabled value="<%= product.sku %>"
            class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 bg-slate-100 text-slate-500 text-xs font-mono">
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Barcode / UPC / EAN</label>
          <input type="text" name="barcode" value="<%= product.barcode %>"
            class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs font-mono focus:outline-none focus:ring-1 focus:ring-blue-500 transition">
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Category</label>
          <select name="category" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs focus:outline-none focus:ring-1 focus:ring-blue-500 transition">
            <option value="">No Category</option>
            <% categories.forEach(cat => { %>
              <option value="<%= cat._id %>" <%= product.category && product.category.toString() === cat._id.toString() ? 'selected' : '' %>>
                <%= cat.name %>
              </option>
            <% }) %>
          </select>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Default Supplier</label>
          <select name="supplier" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs focus:outline-none focus:ring-1 focus:ring-blue-500 transition">
            <option value="">None / Walk-in Vendor</option>
            <% suppliers.forEach(sup => { %>
              <option value="<%= sup._id %>" <%= product.supplier && product.supplier.toString() === sup._id.toString() ? 'selected' : '' %>>
                <%= sup.name %>
              </option>
            <% }) %>
          </select>
        </div>

        <div class="md:col-span-2">
          <label class="block text-xs font-semibold text-slate-700 mb-1">Description</label>
          <textarea name="description" rows="2"
            class="w-full px-3.5 py-2 rounded-xl border border-slate-200 text-xs focus:outline-none focus:ring-1 focus:ring-blue-500 transition"><%= product.description %></textarea>
        </div>
      </div>
    </div>

    <!-- Card 2: Pricing & Inventory Parameters -->
    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-2xs p-6 space-y-4">
      <h2 class="text-xs font-semibold uppercase tracking-wider text-slate-500 flex items-center">
        <i data-lucide="dollar-sign" class="w-3.5 h-3.5 mr-1.5 text-emerald-500"></i>
        Pricing & Reorder Parameters
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Cost Price (<%= currentStore.currency %>)</label>
          <input type="number" step="0.01" min="0" name="costPrice" value="<%= product.costPrice %>"
            class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs focus:outline-none focus:ring-1 focus:ring-blue-500 transition">
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Selling Price * (<%= currentStore.currency %>)</label>
          <input type="number" step="0.01" min="0" name="sellingPrice" required value="<%= product.sellingPrice %>"
            class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs font-bold focus:outline-none focus:ring-1 focus:ring-blue-500 transition">
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Low Stock Alert Level</label>
          <input type="number" step="1" min="0" name="reorderLevel" value="<%= product.reorderLevel %>"
            class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs focus:outline-none focus:ring-1 focus:ring-blue-500 transition">
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Unit</label>
          <input type="text" name="unit" value="<%= product.unit %>"
            class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs focus:outline-none focus:ring-1 focus:ring-blue-500 transition">
        </div>
      </div>
      <p class="text-[11px] text-slate-400">
        Note: Current physical stock (<%= product.currentStock %> <%= product.unit %>) can be altered via <a href="/stock/adjust?productId=<%= product._id %>" class="text-blue-600 underline">Stock Adjustment</a>.
      </p>
    </div>

    <!-- Card 3: Dynamic Store Custom Attributes -->
    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-2xs p-6 space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-xs font-semibold uppercase tracking-wider text-indigo-600 flex items-center">
            <i data-lucide="sparkles" class="w-3.5 h-3.5 mr-1.5"></i>
            Store Custom Attributes (<%= currentStore.storeType %>)
          </h2>
          <p class="text-slate-400 text-[11px] mt-0.5">Attributes tailored specifically to your store type.</p>
        </div>
        <a href="/settings/custom-fields" target="_blank" class="text-xs text-indigo-600 hover:text-indigo-800 font-medium">
          Manage Fields
        </a>
      </div>

      <% if (customFields && customFields.length > 0) { %>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-1">
          <% customFields.forEach(field => { %>
            <% const currentVal = product.customFields ? product.customFields[field.key] : ''; %>
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">
                <%= field.label %>
                <% if (field.required) { %><span class="text-red-500">*</span><% } %>
              </label>

              <% if (field.type === 'text') { %>
                <input type="text" name="customFields[<%= field.key %>]" value="<%= currentVal || '' %>"
                  <%= field.required ? 'required' : '' %>
                  class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs focus:outline-none focus:ring-1 focus:ring-indigo-500 transition">

              <% } else if (field.type === 'number') { %>
                <input type="number" step="any" name="customFields[<%= field.key %>]" value="<%= currentVal !== undefined ? currentVal : '' %>"
                  <%= field.required ? 'required' : '' %>
                  class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs focus:outline-none focus:ring-1 focus:ring-indigo-500 transition">

              <% } else if (field.type === 'date') { %>
                <% const dateStr = currentVal ? new Date(currentVal).toISOString().split('T')[0] : ''; %>
                <input type="date" name="customFields[<%= field.key %>]" value="<%= dateStr %>"
                  <%= field.required ? 'required' : '' %>
                  class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs focus:outline-none focus:ring-1 focus:ring-indigo-500 transition">

              <% } else if (field.type === 'select') { %>
                <select name="customFields[<%= field.key %>]" <%= field.required ? 'required' : '' %>
                  class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs focus:outline-none focus:ring-1 focus:ring-indigo-500 transition">
                  <option value="">Select <%= field.label %></option>
                  <% (field.options || []).forEach(opt => { %>
                    <option value="<%= opt %>" <%= currentVal === opt ? 'selected' : '' %>><%= opt %></option>
                  <% }) %>
                </select>

              <% } else if (field.type === 'boolean') { %>
                <div class="flex items-center h-10">
                  <label class="relative flex items-center cursor-pointer">
                    <input type="checkbox" name="customFields[<%= field.key %>]" value="true"
                      <%= currentVal === true || currentVal === 'true' ? 'checked' : '' %>
                      class="w-4 h-4 text-indigo-600 rounded border-slate-300 focus:ring-indigo-500">
                    <span class="ml-2 text-xs text-slate-700"><%= field.description || `Enable ${field.label}` %></span>
                  </label>
                </div>
              <% } %>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <p class="text-xs text-slate-400">No custom fields configured.</p>
      <% } %>
    </div>

    <!-- Actions -->
    <div class="flex items-center justify-between pt-2">
      <form action="/products/<%= product._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Are you sure you want to permanently delete this product?');">
        <!-- Separate delete button in footer -->
      </form>
      <button type="button" onclick="if(confirm('Are you sure you want to delete this product?')) { document.getElementById('deleteProductForm').submit(); }"
        class="text-xs font-semibold text-red-600 hover:text-red-700">
        Delete Product
      </button>

      <div class="flex items-center space-x-3">
        <a href="/products/<%= product._id %>" class="px-4 py-2 text-xs font-medium text-slate-600 hover:text-slate-800">Cancel</a>
        <button type="submit" class="px-6 py-2.5 rounded-xl font-semibold text-xs text-white shadow-sm transition hover:opacity-95" style="background-color: <%= brandColor %>;">
          Update Product
        </button>
      </div>
    </div>
  </form>

  <form id="deleteProductForm" action="/products/<%= product._id %>?_method=DELETE" method="POST" class="hidden"></form>
</div>

