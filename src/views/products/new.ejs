<div class="max-w-4xl mx-auto space-y-6">
  <!-- Header -->
  <div class="flex items-center justify-between">
    <div>
      <a href="/products" class="inline-flex items-center text-xs text-slate-500 hover:text-slate-800 mb-1">
        <i data-lucide="arrow-left" class="w-3.5 h-3.5 mr-1"></i>
        Back to Products Catalog
      </a>
      <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Add New Product</h1>
      <p class="text-slate-500 text-xs">Register inventory with standard pricing and store-specific custom attributes.</p>
    </div>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="p-3.5 rounded-xl bg-red-50 border border-red-200 text-red-600 text-xs flex items-center">
      <i data-lucide="alert-circle" class="w-4 h-4 mr-2 flex-shrink-0"></i>
      <span><%= error %></span>
    </div>
  <% } %>

  <form action="/products" method="POST" class="space-y-6">
    <!-- Card 1: Core Details -->
    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-2xs p-6 space-y-4">
      <h2 class="text-xs font-semibold uppercase tracking-wider text-slate-500 flex items-center">
        <i data-lucide="info" class="w-3.5 h-3.5 mr-1.5 text-blue-500"></i>
        Core Product Information
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="md:col-span-2">
          <label class="block text-xs font-semibold text-slate-700 mb-1">Product Name *</label>
          <input type="text" name="name" required placeholder="e.g. Organic Rolled Oats 500g or Oxford Slim Shirt"
            value="<%= typeof data !== 'undefined' && data.name ? data.name : '' %>"
            class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs focus:outline-none focus:ring-1 focus:ring-blue-500 transition">
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">SKU (Stock Keeping Unit)</label>
          <input type="text" name="sku" placeholder="Leave blank to auto-generate"
            value="<%= typeof data !== 'undefined' && data.sku ? data.sku : '' %>"
            class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs font-mono uppercase focus:outline-none focus:ring-1 focus:ring-blue-500 transition">
          <p class="text-[10px] text-slate-400 mt-1">Unique item identifier in this store.</p>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Barcode / UPC / EAN</label>
          <input type="text" name="barcode" placeholder="e.g. 789123456789 or scan"
            value="<%= typeof data !== 'undefined' && data.barcode ? data.barcode : '' %>"
            class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs font-mono focus:outline-none focus:ring-1 focus:ring-blue-500 transition">
          <p class="text-[10px] text-slate-400 mt-1">Used for hardware scanner and POS lookup.</p>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Category</label>
          <select name="category" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs focus:outline-none focus:ring-1 focus:ring-blue-500 transition">
            <option value="">No Category</option>
            <% categories.forEach(cat => { %>
              <option value="<%= cat._id %>" <%= typeof data !== 'undefined' && data.category == cat._id.toString() ? 'selected' : '' %>>
                <%= cat.name %>
              </option>
            <% }) %>
          </select>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Default Supplier</label>
          <select name="supplier" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs focus:outline-none focus:ring-1 focus:ring-blue-500 transition">
            <option value="">None / Walk-in Vendor</option>
            <% suppliers.forEach(sup => { %>
              <option value="<%= sup._id %>" <%= typeof data !== 'undefined' && data.supplier == sup._id.toString() ? 'selected' : '' %>>
                <%= sup.name %>
              </option>
            <% }) %>
          </select>
        </div>

        <div class="md:col-span-2">
          <label class="block text-xs font-semibold text-slate-700 mb-1">Product Description</label>
          <textarea name="description" rows="2" placeholder="Optional product description, specifications, or internal notes..."
            class="w-full px-3.5 py-2 rounded-xl border border-slate-200 text-xs focus:outline-none focus:ring-1 focus:ring-blue-500 transition"><%= typeof data !== 'undefined' && data.description ? data.description : '' %></textarea>
        </div>
      </div>
    </div>

    <!-- Card 2: Pricing & Inventory Levels -->
    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-2xs p-6 space-y-4">
      <h2 class="text-xs font-semibold uppercase tracking-wider text-slate-500 flex items-center">
        <i data-lucide="dollar-sign" class="w-3.5 h-3.5 mr-1.5 text-emerald-500"></i>
        Pricing & Initial Stock Intake
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Cost Price (<%= currentStore.currency %>)</label>
          <input type="number" step="0.01" min="0" name="costPrice" placeholder="0.00"
            value="<%= typeof data !== 'undefined' && data.costPrice ? data.costPrice : '' %>"
            class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs focus:outline-none focus:ring-1 focus:ring-blue-500 transition">
          <p class="text-[10px] text-slate-400 mt-1">Acquisition cost from supplier.</p>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Retail Selling Price * (<%= currentStore.currency %>)</label>
          <input type="number" step="0.01" min="0" name="sellingPrice" required placeholder="0.00"
            value="<%= typeof data !== 'undefined' && data.sellingPrice ? data.sellingPrice : '' %>"
            class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs font-bold focus:outline-none focus:ring-1 focus:ring-blue-500 transition">
          <p class="text-[10px] text-slate-400 mt-1">Price charged to customer on POS.</p>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Initial Stock Quantity</label>
          <input type="number" step="1" name="initialStock" placeholder="0"
            value="<%= typeof data !== 'undefined' && data.initialStock ? data.initialStock : '0' %>"
            class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs focus:outline-none focus:ring-1 focus:ring-blue-500 transition">
          <p class="text-[10px] text-slate-400 mt-1">Logs initial stock movement automatically.</p>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Unit of Measurement</label>
          <input type="text" name="unit" placeholder="pcs, kg, box, pack, pair"
            value="<%= typeof data !== 'undefined' && data.unit ? data.unit : 'pcs' %>"
            class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs focus:outline-none focus:ring-1 focus:ring-blue-500 transition">
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Low Stock Alert Threshold</label>
          <input type="number" step="1" min="0" name="reorderLevel" placeholder="5"
            value="<%= typeof data !== 'undefined' && data.reorderLevel ? data.reorderLevel : currentStore.lowStockThreshold || '5' %>"
            class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs focus:outline-none focus:ring-1 focus:ring-blue-500 transition">
          <p class="text-[10px] text-slate-400 mt-1">Triggers reorder warnings when reached.</p>
        </div>
      </div>
    </div>

    <!-- Card 3: Dynamic Store-Customizable Fields -->
    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-2xs p-6 space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-xs font-semibold uppercase tracking-wider text-indigo-600 flex items-center">
            <i data-lucide="sparkles" class="w-3.5 h-3.5 mr-1.5"></i>
            Store Custom Attributes (<%= currentStore.storeType %>)
          </h2>
          <p class="text-slate-400 text-[11px] mt-0.5">Attributes tailored specifically to your store type.</p>
        </div>
        <a href="/settings/custom-fields" target="_blank" class="text-xs text-indigo-600 hover:text-indigo-800 font-medium">
          + Manage Fields
        </a>
      </div>

      <% if (customFields && customFields.length > 0) { %>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-1">
          <% customFields.forEach(field => { %>
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">
                <%= field.label %>
                <% if (field.required) { %><span class="text-red-500">*</span><% } %>
              </label>

              <% if (field.type === 'text') { %>
                <input type="text" name="customFields[<%= field.key %>]" <%= field.required ? 'required' : '' %>
                  placeholder="<%= field.description || field.label %>"
                  class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs focus:outline-none focus:ring-1 focus:ring-indigo-500 transition">

              <% } else if (field.type === 'number') { %>
                <input type="number" step="any" name="customFields[<%= field.key %>]" <%= field.required ? 'required' : '' %>
                  placeholder="0"
                  class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs focus:outline-none focus:ring-1 focus:ring-indigo-500 transition">

              <% } else if (field.type === 'date') { %>
                <input type="date" name="customFields[<%= field.key %>]" <%= field.required ? 'required' : '' %>
                  class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs focus:outline-none focus:ring-1 focus:ring-indigo-500 transition">

              <% } else if (field.type === 'select') { %>
                <select name="customFields[<%= field.key %>]" <%= field.required ? 'required' : '' %>
                  class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs focus:outline-none focus:ring-1 focus:ring-indigo-500 transition">
                  <option value="">Select <%= field.label %></option>
                  <% (field.options || []).forEach(opt => { %>
                    <option value="<%= opt %>"><%= opt %></option>
                  <% }) %>
                </select>

              <% } else if (field.type === 'boolean') { %>
                <div class="flex items-center h-10">
                  <label class="relative flex items-center cursor-pointer">
                    <input type="checkbox" name="customFields[<%= field.key %>]" value="true"
                      class="w-4 h-4 text-indigo-600 rounded border-slate-300 focus:ring-indigo-500">
                    <span class="ml-2 text-xs text-slate-700"><%= field.description || `Enable ${field.label}` %></span>
                  </label>
                </div>
              <% } %>

              <% if (field.description && field.type !== 'boolean') { %>
                <p class="text-[10px] text-slate-400 mt-1"><%= field.description %></p>
              <% } %>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="p-4 bg-slate-50 rounded-xl text-center text-xs text-slate-500">
          No custom fields configured for this store yet. 
          <a href="/settings/custom-fields" class="text-indigo-600 font-semibold hover:underline">Add custom fields</a> to track attributes like Expiry, Size, Brand, or Serial Numbers.
        </div>
      <% } %>
    </div>

    <!-- Actions -->
    <div class="flex items-center justify-end space-x-3 pt-2">
      <a href="/products" class="px-4 py-2 text-xs font-medium text-slate-600 hover:text-slate-800">Cancel</a>
      <button type="submit" class="px-6 py-2.5 rounded-xl font-semibold text-xs text-white shadow-sm transition hover:opacity-95" style="background-color: <%= brandColor %>;">
        Save & Register Product
      </button>
    </div>
  </form>
</div>

