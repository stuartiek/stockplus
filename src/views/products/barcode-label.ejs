<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Shelf Label - <%= product.sku %></title>
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  <script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.5/dist/JsBarcode.all.min.js"></script>
  <style>
    @page {
      size: 58mm 40mm;
      margin: 0;
    }
    @media print {
      body {
        margin: 0;
        padding: 0;
      }
      .no-print {
        display: none !important;
      }
    }
  </style>
</head>
<body class="bg-slate-100 flex flex-col items-center justify-center min-h-screen p-4">

  <!-- Print Button Bar (hidden when printing) -->
  <div class="mb-4 no-print flex items-center space-x-3">
    <button onclick="window.print()" class="px-4 py-2 bg-blue-600 hover:bg-blue-500 text-white text-xs font-semibold rounded-xl shadow-md cursor-pointer flex items-center gap-2">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path></svg>
      Print Label
    </button>
    <button onclick="window.close()" class="px-4 py-2 bg-slate-200 hover:bg-slate-300 text-slate-700 text-xs font-medium rounded-xl">
      Close
    </button>
  </div>

  <!-- Thermal Label Sticker Container (approx 58mm x 40mm) -->
  <div class="w-[300px] bg-white border border-slate-300 rounded-xl p-4 shadow-lg text-slate-900 font-sans">
    <div class="flex justify-between items-start border-b border-slate-200 pb-2 mb-2">
      <div>
        <span class="text-[10px] uppercase tracking-wider font-bold text-slate-500 block"><%= currentStore.name %></span>
        <h2 class="text-sm font-bold text-slate-900 leading-tight truncate max-w-[170px]"><%= product.name %></h2>
        <% if (product.category) { %>
          <span class="text-[9px] text-slate-500"><%= product.category.name %></span>
        <% } %>
      </div>
      <div class="text-right">
        <span class="text-lg font-black text-slate-900 leading-none">
          <%= formatMoney(product.sellingPrice) %>
        </span>
        <span class="block text-[9px] text-slate-400">per <%= product.unit %></span>
      </div>
    </div>

    <!-- Barcode & QR Row -->
    <div class="flex items-center justify-between gap-2 mt-2">
      <div class="flex-1 flex flex-col items-center">
        <svg id="labelBarcode" class="w-full h-10"></svg>
        <span class="text-[10px] font-mono tracking-widest font-semibold mt-0.5"><%= product.barcode || product.sku %></span>
      </div>
      <div class="flex-shrink-0">
        <img src="<%= qrCodeUrl %>" alt="QR" class="w-12 h-12">
      </div>
    </div>

    <div class="flex justify-between items-center text-[9px] text-slate-400 border-t border-slate-100 pt-1.5 mt-2">
      <span class="font-mono">SKU: <%= product.sku %></span>
      <span>StockPlus</span>
    </div>
  </div>

  <script>
    try {
      JsBarcode("#labelBarcode", "<%= product.barcode || product.sku %>", {
        format: "CODE128",
        width: 1.5,
        height: 38,
        displayValue: false,
        margin: 0
      });
    } catch (e) {
      console.error(e);
    }
  </script>
</body>
</html>

