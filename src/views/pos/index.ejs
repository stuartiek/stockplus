  }

  // 2. Submenu Modal Execution
  function openSubmenuModal(btn) {
    const data = btn.actionData || {};
    document.getElementById('submenuModalTitle').textContent = data.title || btn.label;
    const grid = document.getElementById('submenuGrid');
    grid.innerHTML = '';

    const items = data.items || [];
    if (items.length === 0) {
      grid.innerHTML = `<p class="col-span-2 text-center text-xs text-slate-400 py-6">No submenu items configured.</p>`;
    } else {
      items.forEach((item, idx) => {
        const itemBtn = document.createElement('button');
        itemBtn.type = 'button';
        itemBtn.className = 'p-3 rounded-2xl border border-slate-200 bg-white hover:bg-emerald-50 hover:border-emerald-500 text-left cursor-pointer transition active:scale-95 shadow-2xs';
        itemBtn.innerHTML = `
          <div class="font-bold text-xs text-slate-800">${item.name}</div>
          <div class="text-xs font-black text-emerald-600 mt-1">${currencySymbol}${Number(item.price).toFixed(2)}</div>
        `;
        itemBtn.onclick = () => {
          playAudioFeedback('beep');
          addToCart(`sub-${Date.now()}-${idx}`, item.name, Number(item.price), 9999, 'SUBMENU', true);
        };
        grid.appendChild(itemBtn);
      });
    }

    document.getElementById('dynamicSubmenuModal').classList.remove('hidden');
    document.getElementById('dynamicSubmenuModal').classList.add('flex');
