    document.getElementById('infoModalContent').textContent = data.content || 'No guidelines provided.';
    lucide.createIcons();
    document.getElementById('dynamicInfoModal').classList.remove('hidden');
    document.getElementById('dynamicInfoModal').classList.add('flex');
