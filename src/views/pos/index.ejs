  function editCustomButton(btnId) {
    playAudioFeedback('click');
    const btn = activeCustomButtons.find(b => b.id === btnId);
    if (!btn) return;

    document.getElementById('editorModalHeader').textContent = 'Edit Custom POS Button';
    document.getElementById('editButtonId').value = btn.id;
    document.getElementById('btnInputLabel').value = btn.label;
    document.getElementById('btnInputIcon').value = btn.icon || 'sparkles';
    document.getElementById('btnInputColor').value = btn.color || 'emerald';
    document.getElementById('btnInputActionType').value = btn.actionType || 'popup_prompt';
    toggleActionFields();

    const data = btn.actionData || {};
    if (btn.actionType === 'popup_prompt') {
      document.getElementById('promptTitleInput').value = data.title || '';
    } else if (btn.actionType === 'popup_submenu') {
      document.getElementById('submenuTitleInput').value = data.title || '';
      const itemsText = (data.items || []).map(i => `${i.name}: ${i.price}`).join('\n');
      document.getElementById('submenuItemsInput').value = itemsText;
    } else if (btn.actionType === 'info_modal') {
      document.getElementById('infoTitleInput').value = data.title || '';
      document.getElementById('infoContentInput').value = data.content || '';
    } else if (btn.actionType === 'add_item') {
      document.getElementById('directItemName').value = data.name || '';
      document.getElementById('directItemPrice').value = data.price || '';
    } else if (btn.actionType === 'discount') {
      document.getElementById('directDiscountPct').value = data.percentage || '';
