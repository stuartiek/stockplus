  function toggleActionFields() {
    const type = document.getElementById('btnInputActionType').value;
    document.getElementById('fieldsPrompt').classList.toggle('hidden', type !== 'popup_prompt');
    document.getElementById('fieldsSubmenu').classList.toggle('hidden', type !== 'popup_submenu');
    document.getElementById('fieldsInfo').classList.toggle('hidden', type !== 'info_modal');
    document.getElementById('fieldsAddItem').classList.toggle('hidden', type !== 'add_item');
    document.getElementById('fieldsDiscount').classList.toggle('hidden', type !== 'discount');
  }

  async function handleSaveCustomButton(e) {
    e.preventDefault();
    const btnId = document.getElementById('editButtonId').value;
    const label = document.getElementById('btnInputLabel').value.trim();
    const icon = document.getElementById('btnInputIcon').value;
    const color = document.getElementById('btnInputColor').value;
    const actionType = document.getElementById('btnInputActionType').value;

    let actionData = {};
    if (actionType === 'popup_prompt') {
      actionData = {
        title: document.getElementById('promptTitleInput').value.trim() || label,
        defaultName: label
      };
    } else if (actionType === 'popup_submenu') {
      const title = document.getElementById('submenuTitleInput').value.trim() || label;
      const rawLines = document.getElementById('submenuItemsInput').value.split('\n');
      const items = [];
      rawLines.forEach(line => {
        const parts = line.split(':');
        if (parts.length >= 2) {
          const name = parts[0].trim();
          const price = parseFloat(parts[1].trim()) || 0;
          if (name) items.push({ name, price });
        }
      });
      actionData = { title, items };
    } else if (actionType === 'info_modal') {
      actionData = {
        title: document.getElementById('infoTitleInput').value.trim() || label,
        content: document.getElementById('infoContentInput').value.trim()
      };
    } else if (actionType === 'add_item') {
      actionData = {
        name: document.getElementById('directItemName').value.trim() || label,
        price: parseFloat(document.getElementById('directItemPrice').value) || 0
      };
    } else if (actionType === 'discount') {
      actionData = {
        percentage: parseFloat(document.getElementById('directDiscountPct').value) || 10
      };
    }

    const payload = { label, icon, color, actionType, actionData };

    try {
      let res;
      if (btnId) {
        res = await fetch(`/pos/buttons/${btnId}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
      } else {
        res = await fetch('/pos/buttons', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
      }
      const data = await res.json();
      if (data.success) {
        closeButtonEditorModal();
        window.location.reload();
      } else {
        alert(data.message || 'Failed to save button.');
      }
    } catch(err) {
      console.error(err);
      alert('Error saving custom button.');
    }
  }

  async function deleteCustomButton(btnId) {
    if (!confirm('Delete this custom button?')) return;
    try {
      const res = await fetch(`/pos/buttons/${btnId}`, { method: 'DELETE' });
      const data = await res.json();
      if (data.success) {
        activeCustomButtons = activeCustomButtons.filter(b => b.id !== btnId);
        const el = document.getElementById(btnId);
        if (el) el.remove();
        if (activeCustomButtons.length === 0) {
          document.getElementById('btnEmptyAdd').classList.remove('hidden');
        }
      }
    } catch(err) {
      console.error(err);
    }
  }

  // ==================== DRAG AND DROP / TOUCH MOVE REORDERING ====================
  function initDragAndDrop() {
    const container = document.getElementById('quickButtonsContainer');
    let draggedItem = null;

    container.querySelectorAll('.quick-action-btn').forEach(btn => {
      btn.addEventListener('dragstart', (e) => {
        if (!isRearrangeMode) return;
        draggedItem = btn;
        btn.classList.add('opacity-50', 'scale-105');
        e.dataTransfer.effectAllowed = 'move';
      });

      btn.addEventListener('dragend', () => {
        if (!isRearrangeMode) return;
        btn.classList.remove('opacity-50', 'scale-105');
        draggedItem = null;
        saveButtonsOrder();
      });

      btn.addEventListener('dragover', (e) => {
        if (!isRearrangeMode || !draggedItem || draggedItem === btn) return;
        e.preventDefault();
        const rect = btn.getBoundingClientRect();
        const midX = rect.left + rect.width / 2;
        if (e.clientX < midX) {
          container.insertBefore(draggedItem, btn);
        } else {
          container.insertBefore(draggedItem, btn.nextSibling);
        }
      });
    });

    // Touch Drag Support for Touchscreens / Tablets
    container.querySelectorAll('.quick-action-btn').forEach(btn => {
      let touchMoved = false;

      btn.addEventListener('touchstart', (e) => {
        if (!isRearrangeMode) return;
        draggedItem = btn;
        btn.classList.add('opacity-50', 'ring-4', 'ring-amber-500');
        touchMoved = true;
      }, { passive: true });

      btn.addEventListener('touchmove', (e) => {
        if (!isRearrangeMode || !draggedItem) return;
        const touch = e.touches[0];
        const target = document.elementFromPoint(touch.clientX, touch.clientY);
        const closestBtn = target ? target.closest('.quick-action-btn') : null;

        if (closestBtn && closestBtn !== draggedItem && closestBtn.parentNode === container) {
          const rect = closestBtn.getBoundingClientRect();
          const midX = rect.left + rect.width / 2;
          if (touch.clientX < midX) {
            container.insertBefore(draggedItem, closestBtn);
          } else {
            container.insertBefore(draggedItem, closestBtn.nextSibling);
          }
        }
      }, { passive: true });

      btn.addEventListener('touchend', () => {
        if (!isRearrangeMode || !draggedItem) return;
        btn.classList.remove('opacity-50', 'ring-4', 'ring-amber-500');
        draggedItem = null;
        saveButtonsOrder();
      });
    });
  }

  async function saveButtonsOrder() {
    const container = document.getElementById('quickButtonsContainer');
    const orderedIds = [];
    container.querySelectorAll('.quick-action-btn').forEach(b => {
      const id = b.getAttribute('data-button-id');
      if (id) orderedIds.push(id);
    });

    try {
      await fetch('/pos/buttons/reorder', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ orderedIds })
      });
    } catch(err) {
      console.error('Save order error:', err);
    }
  }

  // Restore cart on page load (e.g. returning from /pos/payment)
  document.addEventListener('DOMContentLoaded', () => {
    try {
      const savedCart = sessionStorage.getItem('stockplus_pos_cart');
      if (savedCart) {
        const parsed = JSON.parse(savedCart);
        if (Array.isArray(parsed) && parsed.length > 0) {
          cart = parsed;
        }
      }
      const savedCustomer = sessionStorage.getItem('stockplus_pos_customer');
      if (savedCustomer && document.getElementById('posCustomerName')) {
        document.getElementById('posCustomerName').value = savedCustomer;
      }
      const savedDiscount = sessionStorage.getItem('stockplus_pos_discount');
      if (savedDiscount) {
        currentDiscountPct = parseFloat(savedDiscount) || 0;
      }
    } catch(e) {
      console.error('Failed to load cart from session:', e);
    }
    renderCart();

    const custInput = document.getElementById('posCustomerName');
    if (custInput) {
      custInput.addEventListener('input', () => {
        saveCartSession();
      });
    }
  });
</script>
