    document.getElementById('dynamicInfoModal').classList.remove('flex');
  }

  // 4. Custom Button Creator & Editor Modal
  function openButtonEditorModal() {
    playAudioFeedback('click');
    document.getElementById('editorModalHeader').textContent = 'Create Custom POS Button';
    document.getElementById('editButtonId').value = '';
    document.getElementById('btnInputLabel').value = '';
    document.getElementById('btnInputIcon').value = 'sparkles';
    document.getElementById('btnInputColor').value = 'emerald';
    document.getElementById('btnInputActionType').value = 'popup_prompt';
