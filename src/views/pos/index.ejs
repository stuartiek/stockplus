<!-- ==================== JAVASCRIPT CONTROLLERS ==================== -->
<script>
  // POS State & Configuration
  let cart = [];
  let parkedCart = null;
  let selectedCartItemId = null;
  let numpadMode = 'qty'; // 'qty' or 'disc'
  let currentDiscountPct = 0;
  let isRearrangeMode = false;
  let activeCustomButtons = <%- JSON.stringify(customButtons || []) %>;

  const currencySymbol = "<%= currentStore.currency %>";
  const taxRate = <%= currentStore.taxRate || 0 %>;
  const enableSound = <%= posSettings.enableSoundEffects !== false %>;

  // Web Audio Synth for Touch / Scan Feedback
  function playAudioFeedback(type = 'click') {
    if (!enableSound) return;
    try {
      const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.connect(gain);
      gain.connect(audioCtx.destination);

      if (type === 'beep') {
        osc.frequency.setValueAtTime(880, audioCtx.currentTime);
        gain.gain.setValueAtTime(0.1, audioCtx.currentTime);
        osc.start();
        osc.stop(audioCtx.currentTime + 0.08);
      } else {
        osc.frequency.setValueAtTime(440, audioCtx.currentTime);
        gain.gain.setValueAtTime(0.05, audioCtx.currentTime);
        osc.start();
        osc.stop(audioCtx.currentTime + 0.04);
      }
    } catch(e) {}
  }

  // Handle Touch on Product Tile
  function handleProductTap(productId, name, unitPrice, stock, sku) {
    playAudioFeedback('beep');
    addToCart(productId, name, unitPrice, stock, sku);
  }

  function addToCart(productId, name, unitPrice, stock, sku, isCustom = false) {
    const existing = cart.find(i => i.productId === productId);
    if (existing) {
      if (!isCustom && existing.quantity >= stock) {
        alert(`Cannot add more. Only ${stock} units in stock.`);
        return;
      }
      existing.quantity += 1;
      selectedCartItemId = productId;
    } else {
      if (!isCustom && stock <= 0) {
        alert("This item is currently out of stock!");
        return;
      }
      cart.push({
        productId,
        name,
        unitPrice: Number(unitPrice),
        quantity: 1,
        stock: Number(stock),
        sku,
        isCustom
      });
      selectedCartItemId = productId;
    }
    renderCart();
  }

  function updateQty(productId, delta) {
    playAudioFeedback('click');
    const item = cart.find(i => i.productId === productId);
    if (!item) return;

    item.quantity += delta;
    if (!item.isCustom && item.quantity > item.stock) {
      alert(`Only ${item.stock} available in stock.`);
      item.quantity = item.stock;
    }
    if (item.quantity <= 0) {
      cart = cart.filter(i => i.productId !== productId);
      if (selectedCartItemId === productId) selectedCartItemId = null;
    }
    renderCart();
  }

  function selectCartItem(productId) {
    playAudioFeedback('click');
    selectedCartItemId = productId;
    renderCart();
  }

  function removeFromCart(productId) {
    playAudioFeedback('click');
    cart = cart.filter(i => i.productId !== productId);
    if (selectedCartItemId === productId) selectedCartItemId = null;
    renderCart();
  }

  function clearCart() {
    playAudioFeedback('click');
    cart = [];
    selectedCartItemId = null;
    currentDiscountPct = 0;
    try {
      sessionStorage.removeItem('stockplus_pos_cart');
      sessionStorage.removeItem('stockplus_pos_customer');
      sessionStorage.removeItem('stockplus_pos_discount');
    } catch(e) {}
    renderCart();
  }

  // Park & Recall Orders
  function parkCurrentOrder() {
    if (cart.length === 0) return;
    playAudioFeedback('click');
    parkedCart = {
      items: [...cart],
      customerName: document.getElementById('posCustomerName').value,
      discountPct: currentDiscountPct
    };
    cart = [];
    document.getElementById('posCustomerName').value = '';
    currentDiscountPct = 0;
    document.getElementById('btnRecallOrder').classList.remove('hidden');
    renderCart();
  }

  function recallParkedOrder() {
    if (!parkedCart) return;
    playAudioFeedback('click');
    cart = [...parkedCart.items];
    document.getElementById('posCustomerName').value = parkedCart.customerName || '';
    currentDiscountPct = parkedCart.discountPct || 0;
    parkedCart = null;
    document.getElementById('btnRecallOrder').classList.add('hidden');
    renderCart();
  }

  // Numpad Functions
  function setNumpadMode(mode) {
    playAudioFeedback('click');
    numpadMode = mode;
    document.getElementById('modeBtn-qty').className = mode === 'qty' ? 'px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-600 text-white cursor-pointer' : 'px-2 py-0.5 rounded text-[10px] font-semibold text-slate-500 cursor-pointer';
    document.getElementById('modeBtn-disc').className = mode === 'disc' ? 'px-2 py-0.5 rounded text-[10px] font-bold bg-indigo-600 text-white cursor-pointer' : 'px-2 py-0.5 rounded text-[10px] font-semibold text-slate-500 cursor-pointer';
  }

  function numpadPress(val) {
    playAudioFeedback('click');
    if (numpadMode === 'qty') {
      if (!selectedCartItemId && cart.length > 0) {
        selectedCartItemId = cart[cart.length - 1].productId;
      }
      const item = cart.find(i => i.productId === selectedCartItemId);
      if (!item) return;

      if (val === 'C') {
        item.quantity = 1;
      } else if (val === 'BACK') {
        const str = item.quantity.toString();
        item.quantity = str.length > 1 ? parseInt(str.slice(0, -1), 10) : 1;
      } else {
        const curStr = item.quantity === 1 ? '' : item.quantity.toString();
        const nextVal = parseInt(curStr + val, 10);
        if (!isNaN(nextVal) && nextVal > 0) {
          if (!item.isCustom && nextVal > item.stock) {
            alert(`Only ${item.stock} in stock.`);
            item.quantity = item.stock;
          } else {
            item.quantity = nextVal;
          }
        }
      }
      renderCart();
    } else if (numpadMode === 'disc') {
      if (val === 'C' || val === 'BACK') {
        currentDiscountPct = 0;
      } else {
        const nextVal = parseFloat((currentDiscountPct || '').toString() + val);
        if (!isNaN(nextVal) && nextVal <= 100) {
          currentDiscountPct = nextVal;
        }
      }
      renderCartSummary();
    }
  }

  function quickDiscountApply(pct) {
    playAudioFeedback('click');
    currentDiscountPct = pct;
    renderCartSummary();
  }

  // Custom Line Item Modal
  function openCustomItemModal() {
    playAudioFeedback('click');
    document.getElementById('customItemName').value = '';
    document.getElementById('customItemPrice').value = '';
    document.getElementById('customItemModal').classList.remove('hidden');
    document.getElementById('customItemModal').classList.add('flex');
  }

  function closeCustomItemModal() {
    document.getElementById('customItemModal').classList.add('hidden');
    document.getElementById('customItemModal').classList.remove('flex');
  }

  function confirmAddCustomItem() {
    const name = document.getElementById('customItemName').value.trim() || 'Custom Item';
    const price = parseFloat(document.getElementById('customItemPrice').value) || 0;
    const customId = `custom-${Date.now()}`;
    addToCart(customId, name, price, 9999, 'MISC', true);
    closeCustomItemModal();
  }

  // Render Cart
  function renderCart() {
    const container = document.getElementById('cartItemsContainer');
    document.getElementById('cartCountBadge').textContent = cart.reduce((a, b) => a + b.quantity, 0);

    if (cart.length === 0) {
      container.innerHTML = `
        <div id="emptyCartMessage" class="h-full flex flex-col items-center justify-center text-center py-12 text-slate-400">
          <i data-lucide="shopping-bag" class="w-12 h-12 mb-2 stroke-1"></i>
          <p class="text-xs font-bold">Cart is empty</p>
          <p class="text-[11px] text-slate-400 mt-0.5">Touch catalog tiles or custom buttons</p>
        </div>`;
      document.getElementById('btnCheckout').disabled = true;
      lucide.createIcons();
      renderCartSummary();
      return;
    }

    document.getElementById('btnCheckout').disabled = false;

    let html = '';
    cart.forEach(item => {
      const isSelected = selectedCartItemId === item.productId;
      const lineTotal = (item.quantity * item.unitPrice).toFixed(2);
      html += `
        <div onclick="selectCartItem('${item.productId}')"
          class="pt-2.5 pb-1 first:pt-0 flex items-center justify-between text-xs cursor-pointer rounded-xl px-2 transition ${isSelected ? 'bg-emerald-500/10 ring-1 ring-emerald-500' : 'hover:bg-slate-500/5'}">
          <div class="flex-1 pr-2">
            <h4 class="font-bold text-slate-800 ${<%= isDark %> ? 'text-white' : ''} truncate">${item.name}</h4>
            <span class="text-[10px] text-slate-400 font-mono">${item.sku} • ${currencySymbol}${item.unitPrice.toFixed(2)}</span>
          </div>
          <div class="flex items-center space-x-2">
            <button onclick="event.stopPropagation(); updateQty('${item.productId}', -1)" class="w-7 h-7 rounded-lg border border-slate-300 flex items-center justify-center hover:bg-slate-200 font-black active:scale-90 cursor-pointer">-</button>
            <span class="w-7 text-center font-black text-sm">${item.quantity}</span>
            <button onclick="event.stopPropagation(); updateQty('${item.productId}', 1)" class="w-7 h-7 rounded-lg border border-slate-300 flex items-center justify-center hover:bg-slate-200 font-black active:scale-90 cursor-pointer">+</button>
            <span class="w-16 text-right font-black text-xs">${currencySymbol}${lineTotal}</span>
            <button onclick="event.stopPropagation(); removeFromCart('${item.productId}')" class="p-1 text-slate-300 hover:text-red-500 cursor-pointer">
              <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
            </button>
          </div>
        </div>
      `;
    });

    container.innerHTML = html;
    lucide.createIcons();
    renderCartSummary();
  }

  function getCalculations() {
    const subtotal = cart.reduce((acc, item) => acc + (item.quantity * item.unitPrice), 0);
    const discount = (subtotal * currentDiscountPct) / 100;
    const discounted = Math.max(0, subtotal - discount);
    const tax = (discounted * taxRate) / 100;
    const total = discounted + tax;
    return { subtotal, discount, tax, total };
  }

  function saveCartSession() {
    try {
      sessionStorage.setItem('stockplus_pos_cart', JSON.stringify(cart));
      const custInput = document.getElementById('posCustomerName');
      if (custInput) {
        sessionStorage.setItem('stockplus_pos_customer', custInput.value.trim());
      }
      sessionStorage.setItem('stockplus_pos_discount', (currentDiscountPct || 0).toString());
    } catch(e) {}
  }

  function renderCartSummary() {
    const { subtotal, discount, tax, total } = getCalculations();
    document.getElementById('cartSubtotal').textContent = `${currencySymbol}${subtotal.toFixed(2)}`;
    document.getElementById('cartDiscountDisplay').textContent = `-${currencySymbol}${discount.toFixed(2)} (${currentDiscountPct}%)`;
    const taxElem = document.getElementById('cartTax');
    if (taxElem) taxElem.textContent = `${currencySymbol}${tax.toFixed(2)}`;
    document.getElementById('cartTotal').textContent = `${currencySymbol}${total.toFixed(2)}`;
    
    // Update Sub Total button display
    const btnSub = document.getElementById('btnSubtotalDisplay');
    if (btnSub) {
      btnSub.textContent = `${currencySymbol}${subtotal.toFixed(2)}`;
    }

    saveCartSession();
  }

  // Navigate to Dedicated Payment & Discounts Page
  function goToPaymentPage() {
    if (cart.length === 0) return;
    playAudioFeedback('click');
    saveCartSession();
    window.location.href = '/pos/payment';
  }

  // Category Touch Tab Filter
  function filterCategory(catId) {
    playAudioFeedback('click');
    document.querySelectorAll('.cat-tab').forEach(b => {
      b.classList.remove('bg-slate-900', 'text-white');
      b.classList.add('border-slate-200');
    });
    const activeTab = document.getElementById(`catTab-${catId}`);
    if (activeTab) {
      activeTab.classList.add('bg-slate-900', 'text-white');
    }

    const tiles = document.querySelectorAll('.product-touch-tile');
    tiles.forEach(tile => {
      if (catId === 'all' || tile.dataset.category === catId) {
        tile.classList.remove('hidden');
      } else {
        tile.classList.add('hidden');
      }
    });
  }

  // Search filter
  const searchInput = document.getElementById('posSearchInput');
  searchInput.addEventListener('input', () => {
    const term = searchInput.value.toLowerCase().trim();
    const tiles = document.querySelectorAll('.product-touch-tile');
    tiles.forEach(tile => {
      const match = tile.dataset.name.includes(term) || tile.dataset.sku.includes(term) || tile.dataset.barcode.includes(term);
      if (match) {
        tile.classList.remove('hidden');
      } else {
        tile.classList.add('hidden');
      }
    });
  });

  searchInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      const visible = document.querySelectorAll('.product-touch-tile:not(.hidden)');
      if (visible.length === 1) {
        visible[0].click();
        searchInput.value = '';
      }
    }
  });

  // Modal Handlers & Quick Tender
  function openCheckoutModal() {
    if (cart.length === 0) return;
    playAudioFeedback('click');
    const { total } = getCalculations();
    document.getElementById('modalTotalDue').textContent = `${currencySymbol}${total.toFixed(2)}`;
    document.getElementById('cashReceivedInput').value = total.toFixed(2);
    calculateChange();
    document.getElementById('checkoutModal').classList.remove('hidden');
    document.getElementById('checkoutModal').classList.add('flex');
  }

  function closeCheckoutModal() {
    document.getElementById('checkoutModal').classList.add('hidden');
    document.getElementById('checkoutModal').classList.remove('flex');
  }

  function toggleCashSection(show) {
    playAudioFeedback('click');
    document.getElementById('cashSection').style.display = show ? 'block' : 'none';
  }

  function setCashTender(val) {
    playAudioFeedback('click');
    const { total } = getCalculations();
    if (val === 'exact') {
      document.getElementById('cashReceivedInput').value = total.toFixed(2);
    } else {
      document.getElementById('cashReceivedInput').value = Number(val).toFixed(2);
    }
    calculateChange();
  }

  function calculateChange() {
    const { total } = getCalculations();
    const paid = parseFloat(document.getElementById('cashReceivedInput').value) || 0;
    const change = Math.max(0, paid - total);
    document.getElementById('changeDueDisplay').textContent = `${currencySymbol}${change.toFixed(2)}`;
  }

  async function submitCheckout() {
    const { discount } = getCalculations();
    const paymentMethod = document.querySelector('input[name="paymentMethod"]:checked').value;
    const cashReceived = parseFloat(document.getElementById('cashReceivedInput').value) || 0;
    const customerName = document.getElementById('posCustomerName').value.trim() || 'Walk-in Customer';

    const payload = {
      items: cart,
      discountAmount: discount,
      paymentMethod,
      cashReceived,
      customerName,
    };

    const btn = document.getElementById('btnConfirmPayment');
    btn.disabled = true;
    btn.textContent = 'Processing...';

    try {
      const res = await fetch('/pos/checkout', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();

      if (data.success) {
        closeCheckoutModal();
        playAudioFeedback('beep');
        document.getElementById('successReceiptNumber').textContent = data.receiptNumber;
        document.getElementById('successChangeDisplay').textContent = `${currencySymbol}${data.changeGiven.toFixed(2)}`;
        document.getElementById('btnViewReceipt').href = `/pos/receipt/${data.saleId}`;
        
        document.getElementById('successModal').classList.remove('hidden');
        document.getElementById('successModal').classList.add('flex');
      } else {
        alert(data.message || 'Payment processing failed.');
      }
    } catch (err) {
      console.error(err);
      alert('Checkout network error.');
    } finally {
      btn.disabled = false;
      btn.textContent = 'COMPLETE SALE';
    }
  }

  function resetPOS() {
    cart = [];
    currentDiscountPct = 0;
    selectedCartItemId = null;
    document.getElementById('posCustomerName').value = '';
    document.getElementById('successModal').classList.add('hidden');
    document.getElementById('successModal').classList.remove('flex');
    renderCart();
  }

  function toggleFullScreen() {
    playAudioFeedback('click');
    if (!document.fullscreenElement) {
      document.documentElement.requestFullscreen().catch(err => console.log(err));
    } else {
      if (document.exitFullscreen) {
        document.exitFullscreen();
      }
    }
  }

  // ==================== CUSTOM MOVABLE BUTTONS & POPUP ACTIONS ====================

  function toggleRearrangeMode() {
    playAudioFeedback('click');
    isRearrangeMode = !isRearrangeMode;
    const btn = document.getElementById('btnRearrangeMode');
    const label = document.getElementById('rearrangeLabel');
    const hint = document.getElementById('rearrangeHint');
    const addBtn = document.getElementById('btnCreateCustomButton');
    const emptyAdd = document.getElementById('btnEmptyAdd');

    if (isRearrangeMode) {
      btn.classList.add('bg-amber-500', 'text-slate-950', 'border-amber-400');
      label.textContent = 'Done Moving';
      hint.classList.remove('hidden');
      addBtn.classList.remove('hidden');
      if (emptyAdd) emptyAdd.classList.remove('hidden');

      // Enable drag handles and editing icons
      document.querySelectorAll('.drag-grip').forEach(el => el.classList.remove('hidden'));
      document.querySelectorAll('.edit-controls').forEach(el => el.classList.remove('hidden'));
      document.querySelectorAll('.quick-action-btn').forEach(el => {
        el.setAttribute('draggable', 'true');
        el.classList.add('ring-2', 'ring-amber-400', 'cursor-grab');
      });
      initDragAndDrop();
    } else {
      btn.classList.remove('bg-amber-500', 'text-slate-950', 'border-amber-400');
      label.textContent = 'Move Buttons';
      hint.classList.add('hidden');
      addBtn.classList.add('hidden');
      if (emptyAdd && activeCustomButtons.length > 0) emptyAdd.classList.add('hidden');

      document.querySelectorAll('.drag-grip').forEach(el => el.classList.add('hidden'));
      document.querySelectorAll('.edit-controls').forEach(el => el.classList.add('hidden'));
      document.querySelectorAll('.quick-action-btn').forEach(el => {
        el.setAttribute('draggable', 'false');
        el.classList.remove('ring-2', 'ring-amber-400', 'cursor-grab');
      });
    }
  }

  // Handle clicking custom action button
  function triggerCustomButton(btnId) {
    if (isRearrangeMode) return; // Do not trigger action when in move mode
    const btn = activeCustomButtons.find(b => b.id === btnId);
    if (!btn) return;

    playAudioFeedback('click');

    if (btn.actionType === 'popup_prompt') {
      openPromptModal(btn);
    } else if (btn.actionType === 'popup_submenu') {
      openSubmenuModal(btn);
    } else if (btn.actionType === 'info_modal') {
      openInfoModal(btn);
    } else if (btn.actionType === 'add_item') {
      const data = btn.actionData || {};
      const price = Number(data.price) || 0;
      const name = data.name || btn.label;
      const sku = data.sku || 'FEE';
      addToCart(`direct-${btn.id}`, name, price, 9999, sku, true);
    } else if (btn.actionType === 'discount') {
      const pct = Number(btn.actionData?.percentage) || 10;
      quickDiscountApply(pct);
    }
  }

  // 1. Prompt Modal Execution
  let currentPromptButton = null;
  function openPromptModal(btn) {
    currentPromptButton = btn;
    const data = btn.actionData || {};
    document.getElementById('promptModalTitle').textContent = data.title || btn.label;
    document.getElementById('promptItemName').value = data.defaultName || btn.label;
    document.getElementById('promptItemPrice').value = data.defaultPrice || '';
    document.getElementById('promptItemNote').value = '';
    document.getElementById('dynamicPromptModal').classList.remove('hidden');
    document.getElementById('dynamicPromptModal').classList.add('flex');
  }

  function closePromptModal() {
    document.getElementById('dynamicPromptModal').classList.add('hidden');
    document.getElementById('dynamicPromptModal').classList.remove('flex');
    currentPromptButton = null;
  }

  function confirmPromptAction() {
    const name = document.getElementById('promptItemName').value.trim() || 'Custom Charge';
    const price = parseFloat(document.getElementById('promptItemPrice').value) || 0;
    const note = document.getElementById('promptItemNote').value.trim();
    const fullName = note ? `${name} (${note})` : name;

    addToCart(`prompt-${Date.now()}`, fullName, price, 9999, 'CUSTOM', true);
