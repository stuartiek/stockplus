<% 
  const isDark = posSettings && posSettings.theme === 'dark';
  const isHighContrast = posSettings && posSettings.theme === 'high-contrast';
  const cartLeft = posSettings && posSettings.layout === 'cart-left';
  const btnSizeClass = (posSettings && posSettings.touchButtonSize === 'jumbo') ? 'py-4 text-base min-h-[56px]' : ((posSettings && posSettings.touchButtonSize === 'regular') ? 'py-2 text-xs min-h-[40px]' : 'py-3 text-sm min-h-[48px]');
  
  let gridColsClass = 'grid-cols-2 sm:grid-cols-3 lg:grid-cols-4';
  if (posSettings && posSettings.gridColumns === 'large') {
    gridColsClass = 'grid-cols-2 sm:grid-cols-2 lg:grid-cols-3';
  } else if (posSettings && posSettings.gridColumns === 'compact') {
    gridColsClass = 'grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5';
  }

  const customButtons = (posSettings && posSettings.quickButtons) ? posSettings.quickButtons.sort((a,b) => (a.order || 0) - (b.order || 0)) : [];
%>

<div id="posRoot" class="h-[calc(100vh-6.5rem)] flex flex-col md:flex-row <%= cartLeft ? 'md:flex-row-reverse' : '' %> gap-4 select-none <%= isDark ? 'text-slate-100' : (isHighContrast ? 'text-black' : 'text-slate-800') %>">
  
  <!-- LEFT/CATALOG AREA: Search, Category Tabs, Custom Movable Buttons, and Touch Product Grid -->
  <div class="flex-1 flex flex-col min-w-0 rounded-2xl border <%= isDark ? 'bg-slate-900 border-slate-800' : (isHighContrast ? 'bg-yellow-50 border-4 border-black' : 'bg-white border-slate-200/80') %> shadow-xs overflow-hidden">
    
    <!-- Top Bar: Search & Utility Controls -->
    <div class="p-3 border-b <%= isDark ? 'border-slate-800 bg-slate-950/40' : (isHighContrast ? 'border-b-4 border-black bg-yellow-100' : 'border-slate-100 bg-slate-50/50') %> flex items-center gap-2">
      <!-- Search Input -->
      <div class="relative flex-1">
        <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none <%= isDark ? 'text-slate-500' : 'text-slate-400' %>">
          <i data-lucide="scan-barcode" class="w-5 h-5 text-emerald-500"></i>
        </span>
        <input type="text" id="posSearchInput" placeholder="Scan barcode or touch to search items..."
          autocomplete="off" autofocus
          class="w-full pl-11 pr-4 py-2.5 rounded-xl border <%= isDark ? 'bg-slate-800 border-slate-700 text-white placeholder-slate-500' : (isHighContrast ? 'bg-white border-2 border-black text-black' : 'bg-white border-slate-200 text-slate-800') %> text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 transition">
      </div>

      <!-- Toggle Movable Buttons & Layout Customizer Button -->
      <button onclick="toggleRearrangeMode()" id="btnRearrangeMode" title="Move & Customize Quick Buttons"
        class="px-3 py-2.5 rounded-xl border <%= isDark ? 'bg-slate-800 border-slate-700 text-slate-300 hover:bg-slate-700' : 'bg-white border-slate-200 text-slate-700 hover:bg-slate-100' %> text-xs font-bold flex items-center gap-1.5 cursor-pointer transition active:scale-95">
        <i data-lucide="move" class="w-4 h-4 text-amber-500"></i>
        <span id="rearrangeLabel" class="hidden sm:inline">Move Buttons</span>
      </button>

      <!-- Custom Item Button -->
      <% if (posSettings && posSettings.allowCustomLineItem !== false) { %>
        <button onclick="openCustomItemModal()" title="Add Custom / Misc Item"
          class="px-3 py-2.5 rounded-xl border <%= isDark ? 'bg-slate-800 border-slate-700 text-slate-300 hover:bg-slate-700' : 'bg-white border-slate-200 text-slate-700 hover:bg-slate-100' %> text-xs font-bold flex items-center gap-1.5 cursor-pointer transition active:scale-95">
          <i data-lucide="plus" class="w-4 h-4 text-emerald-500"></i>
          <span class="hidden sm:inline">Misc Item</span>
        </button>
      <% } %>

      <!-- Fullscreen Kiosk Mode Toggle -->
      <button onclick="toggleFullScreen()" title="Toggle Kiosk Fullscreen"
        class="p-2.5 rounded-xl border <%= isDark ? 'bg-slate-800 border-slate-700 text-slate-300' : 'bg-white border-slate-200 text-slate-700' %> text-xs hover:bg-slate-100 cursor-pointer active:scale-95">
        <i data-lucide="maximize" class="w-4 h-4"></i>
      </button>

      <!-- POS Customizer Quick Link -->
      <a href="/settings/pos" title="Customize Touch POS Screen"
        class="p-2.5 rounded-xl border <%= isDark ? 'bg-slate-800 border-slate-700 text-slate-300' : 'bg-white border-slate-200 text-slate-700' %> text-xs hover:bg-slate-100 cursor-pointer">
        <i data-lucide="settings-2" class="w-4 h-4 text-indigo-500"></i>
      </a>
    </div>

    <!-- MOVABLE QUICK-ACTION & POPUP CUSTOM BUTTONS BAR -->
    <div id="quickButtonsSection" class="p-2.5 border-b <%= isDark ? 'border-slate-800 bg-slate-950/60' : 'border-slate-100 bg-slate-50/60' %>">
      <div class="flex items-center justify-between mb-1.5 px-1">
        <div class="flex items-center space-x-1.5">
          <i data-lucide="sparkles" class="w-3.5 h-3.5 text-amber-500"></i>
          <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Custom Quick Actions</span>
          <span id="rearrangeHint" class="hidden text-[10px] text-amber-500 font-bold bg-amber-500/10 px-2 py-0.5 rounded-full">
            Drag to rearrange • Tap + to create
          </span>
        </div>
        <button onclick="openButtonEditorModal()" id="btnCreateCustomButton" class="hidden text-[11px] font-bold text-emerald-600 hover:text-emerald-700 flex items-center gap-1 cursor-pointer">
          <i data-lucide="plus-circle" class="w-3.5 h-3.5"></i> Add Action Button
        </button>
      </div>

      <!-- Draggable Buttons Container -->
      <div id="quickButtonsContainer" class="flex items-center gap-2 overflow-x-auto no-scrollbar py-1 min-h-[46px]">
        <% if (customButtons && customButtons.length > 0) { %>
          <% customButtons.forEach(btn => { %>
            <div id="<%= btn.id %>" data-button-id="<%= btn.id %>"
              draggable="false"
              onclick="triggerCustomButton('<%= btn.id %>')"
              class="quick-action-btn flex-shrink-0 group relative px-3 py-2 rounded-xl border text-xs font-bold flex items-center gap-2 cursor-pointer transition-all active:scale-95 shadow-2xs
                <%= btn.color === 'emerald' ? (isDark ? 'bg-emerald-950/40 border-emerald-800 text-emerald-300' : 'bg-emerald-50 border-emerald-200 text-emerald-800 hover:bg-emerald-100') :
                   (btn.color === 'blue' ? (isDark ? 'bg-blue-950/40 border-blue-800 text-blue-300' : 'bg-blue-50 border-blue-200 text-blue-800 hover:bg-blue-100') :
                   (btn.color === 'purple' ? (isDark ? 'bg-purple-950/40 border-purple-800 text-purple-300' : 'bg-purple-50 border-purple-200 text-purple-800 hover:bg-purple-100') :
                   (btn.color === 'amber' ? (isDark ? 'bg-amber-950/40 border-amber-800 text-amber-300' : 'bg-amber-50 border-amber-200 text-amber-800 hover:bg-amber-100') :
                   (btn.color === 'rose' ? (isDark ? 'bg-rose-950/40 border-rose-800 text-rose-300' : 'bg-rose-50 border-rose-200 text-rose-800 hover:bg-rose-100') :
                   (isDark ? 'bg-slate-800 border-slate-700 text-slate-300' : 'bg-slate-100 border-slate-200 text-slate-800 hover:bg-slate-200'))))) %>">
              
              <!-- Drag Grip Icon (visible in Move mode) -->
              <span class="drag-grip hidden cursor-grab active:cursor-grabbing text-slate-400">
                <i data-lucide="grip-vertical" class="w-3.5 h-3.5"></i>
              </span>

              <i data-lucide="<%= btn.icon || 'sparkles' %>" class="w-4 h-4 flex-shrink-0"></i>
              <span class="whitespace-nowrap"><%= btn.label %></span>

              <!-- Edit & Delete Controls (visible in Move mode) -->
              <div class="edit-controls hidden items-center space-x-1 ml-1 pl-1 border-l border-slate-300">
                <button type="button" onclick="event.stopPropagation(); editCustomButton('<%= btn.id %>')" title="Edit Button" class="p-0.5 hover:text-blue-500">
                  <i data-lucide="pencil" class="w-3 h-3"></i>
                </button>
                <button type="button" onclick="event.stopPropagation(); deleteCustomButton('<%= btn.id %>')" title="Delete Button" class="p-0.5 hover:text-red-500">
                  <i data-lucide="x" class="w-3 h-3"></i>
                </button>
              </div>
            </div>
          <% }) %>
        <% } %>

        <!-- Add Button Card Placeholder (Always accessible when in Move mode or if empty) -->
        <button type="button" onclick="openButtonEditorModal()" id="btnEmptyAdd"
          class="<%= (customButtons && customButtons.length > 0) ? 'hidden' : 'flex' %> flex-shrink-0 px-3.5 py-2 rounded-xl border border-dashed border-emerald-400 text-emerald-600 hover:bg-emerald-50 text-xs font-bold items-center gap-1.5 cursor-pointer">
          <i data-lucide="plus-circle" class="w-4 h-4"></i>
          <span>Create Custom Action Button</span>
        </button>
      </div>
    </div>

    <!-- Category Filter Touch Tabs (Horizontal scrollable pills) -->
    <% if (posSettings && posSettings.showCategoryTabs !== false && categories && categories.length > 0) { %>
      <div class="px-3 py-2 border-b <%= isDark ? 'border-slate-800 bg-slate-900' : 'border-slate-100 bg-white' %> flex items-center space-x-2 overflow-x-auto no-scrollbar">
        <button onclick="filterCategory('all')" id="catTab-all"
          class="cat-tab px-4 py-2 rounded-xl text-xs font-bold whitespace-nowrap transition cursor-pointer active:scale-95 bg-slate-900 text-white shadow-xs">
          All Products (<%= products.length %>)
        </button>
        <% categories.forEach(cat => { %>
          <button onclick="filterCategory('<%= cat._id %>')" id="catTab-<%= cat._id %>"
            class="cat-tab px-3.5 py-2 rounded-xl text-xs font-semibold whitespace-nowrap transition cursor-pointer active:scale-95 border <%= isDark ? 'border-slate-700 text-slate-300 hover:bg-slate-800' : 'border-slate-200 text-slate-700 hover:bg-slate-50' %>">
            <span class="w-2 h-2 rounded-full inline-block mr-1.5" style="background-color: <%= cat.color %>;"></span>
            <%= cat.name %>
          </button>
        <% }) %>
      </div>
    <% } %>

    <!-- Touch Catalog Grid -->
    <div class="flex-1 overflow-y-auto p-3 sm:p-4">
      <div id="productGrid" class="grid <%= gridColsClass %> gap-3">
        <% if (products && products.length > 0) { %>
          <% products.forEach(p => { %>
            <div onclick="handleProductTap('<%= p._id %>', '<%= p.name.replace(/'/g, "\\'") %>', <%= p.sellingPrice %>, <%= p.currentStock %>, '<%= p.sku %>')"
              data-category="<%= p.category ? p.category._id : 'none' %>"
              data-name="<%= p.name.toLowerCase() %>"
              data-sku="<%= p.sku.toLowerCase() %>"
              data-barcode="<%= (p.barcode || '').toLowerCase() %>"
              class="product-touch-tile group p-3.5 rounded-2xl border <%= isDark ? 'bg-slate-800/90 border-slate-700/80 hover:border-emerald-500' : (isHighContrast ? 'bg-white border-2 border-black hover:border-blue-600' : 'bg-white border-slate-200/90 hover:border-blue-500 hover:shadow-md') %> cursor-pointer transition-all duration-150 flex flex-col justify-between active:scale-95 touch-manipulation">
              <div>
                <% if (p.category) { %>
                  <span class="text-[9px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full inline-block mb-1"
                    style="background-color: <%= p.category.color %>20; color: <%= p.category.color %>;">
                    <%= p.category.name %>
                  </span>
                <% } %>
                <h3 class="text-xs sm:text-sm font-bold <%= isDark ? 'text-white' : 'text-slate-900' %> leading-snug line-clamp-2">
                  <%= p.name %>
                </h3>
                <% if (posSettings.showSkuOnTile !== false) { %>
                  <span class="text-[10px] <%= isDark ? 'text-slate-400' : 'text-slate-400' %> font-mono mt-0.5 block truncate"><%= p.sku %></span>
                <% } %>
              </div>
              <div class="mt-3 pt-2 border-t <%= isDark ? 'border-slate-700' : 'border-slate-100' %> flex items-center justify-between">
                <span class="text-sm sm:text-base font-black <%= isDark ? 'text-emerald-400' : 'text-slate-900' %>">
                  <%= formatMoney(p.sellingPrice) %>
                </span>
                <% if (posSettings.showStockCountOnTile !== false) { %>
                  <span class="text-[10px] font-bold px-2 py-0.5 rounded-md <%= p.currentStock <= p.reorderLevel ? 'bg-amber-100 text-amber-800' : (isDark ? 'bg-slate-700 text-slate-300' : 'bg-slate-100 text-slate-600') %>">
                    <%= p.currentStock %>
                  </span>
                <% } %>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <div class="col-span-full text-center py-16 text-slate-400">
            <i data-lucide="package-search" class="w-12 h-12 mx-auto stroke-1 mb-2"></i>
            <p class="text-sm font-semibold">No catalog items available</p>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <!-- RIGHT/CART AREA: Active Cart, On-Screen Touch Numpad & Quick Tender -->
  <div class="w-full md:w-[380px] lg:w-[420px] flex flex-col rounded-2xl border <%= isDark ? 'bg-slate-900 border-slate-800' : (isHighContrast ? 'bg-yellow-50 border-4 border-black' : 'bg-white border-slate-200/80') %> shadow-xs overflow-hidden">
    
    <!-- Cart Header with Customer Input & Park/Recall buttons -->
    <div class="p-3 border-b <%= isDark ? 'border-slate-800 bg-slate-950/60' : 'border-slate-100 bg-slate-50/60' %> space-y-2">
      <div class="flex items-center justify-between">
        <div class="flex items-center space-x-2">
          <i data-lucide="shopping-cart" class="w-5 h-5 text-emerald-500"></i>
          <h2 class="text-sm font-black <%= isDark ? 'text-white' : 'text-slate-900' %>">Order Cart</h2>
          <span id="cartCountBadge" class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500/20 text-emerald-500">0</span>
        </div>
        
        <div class="flex items-center space-x-1.5">
          <!-- Park / Recall Order Buttons -->
          <button onclick="parkCurrentOrder()" title="Park / Hold Order for customer"
            class="px-2.5 py-1 rounded-lg border <%= isDark ? 'border-slate-700 hover:bg-slate-800' : 'border-slate-200 hover:bg-slate-100' %> text-[11px] font-semibold text-slate-600 flex items-center gap-1 cursor-pointer">
            <i data-lucide="pause-circle" class="w-3.5 h-3.5 text-amber-500"></i>
            <span class="hidden sm:inline">Hold</span>
          </button>
          <button onclick="recallParkedOrder()" id="btnRecallOrder" title="Recall held order"
            class="hidden px-2.5 py-1 rounded-lg bg-amber-500 text-slate-950 text-[11px] font-bold cursor-pointer animate-pulse">
            Recall (<span id="parkedCount">1</span>)
          </button>
          <button onclick="clearCart()" class="p-1 text-slate-400 hover:text-red-500 cursor-pointer" title="Empty Cart">
            <i data-lucide="trash-2" class="w-4 h-4"></i>
          </button>
        </div>
      </div>

      <!-- Customer Name Quick Input -->
      <div class="relative">
        <input type="text" id="posCustomerName" placeholder="Walk-in Customer (touch to edit)"
          class="w-full px-3 py-1.5 rounded-xl border <%= isDark ? 'bg-slate-800 border-slate-700 text-white placeholder-slate-500' : 'bg-white border-slate-200 text-slate-800' %> text-xs focus:outline-none focus:ring-1 focus:ring-emerald-500">
      </div>
    </div>

    <!-- Cart Line Items List (Scrollable) -->
    <div class="flex-1 overflow-y-auto p-3 space-y-2 divide-y <%= isDark ? 'divide-slate-800' : 'divide-slate-100' %>" id="cartItemsContainer">
      <div id="emptyCartMessage" class="h-full flex flex-col items-center justify-center text-center py-12 text-slate-400">
        <i data-lucide="shopping-bag" class="w-12 h-12 mb-2 stroke-1"></i>
        <p class="text-xs font-bold">Cart is empty</p>
        <p class="text-[11px] text-slate-400 mt-0.5">Touch catalog tiles or custom buttons</p>
      </div>
    </div>

    <!-- On-Screen Touch Numpad & Calculator (Collapsible / Toggleable) -->
    <% if (posSettings && posSettings.enableOnScreenNumpad !== false) { %>
      <div id="touchpadContainer" class="p-2 border-t <%= isDark ? 'border-slate-800 bg-slate-950/40' : 'border-slate-100 bg-slate-50/80' %>">
        <div class="flex items-center justify-between mb-1.5 px-1">
          <span class="text-[10px] uppercase font-bold text-slate-400">Touch Calculator & Quantity</span>
          <!-- Active Mode Selector -->
          <div class="flex items-center space-x-1">
            <button onclick="setNumpadMode('qty')" id="modeBtn-qty" class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-600 text-white cursor-pointer">Qty</button>
            <button onclick="setNumpadMode('disc')" id="modeBtn-disc" class="px-2 py-0.5 rounded text-[10px] font-semibold <%= isDark ? 'text-slate-400' : 'text-slate-600' %> cursor-pointer">Disc %</button>
          </div>
        </div>

        <!-- Touch Numpad Grid -->
        <div class="grid grid-cols-4 gap-1 text-sm font-bold">
          <button onclick="numpadPress('1')" class="p-2.5 rounded-lg border <%= isDark ? 'bg-slate-800 border-slate-700 hover:bg-slate-700 text-white' : 'bg-white border-slate-200 hover:bg-slate-100 text-slate-800' %> active:scale-90 transition">1</button>
          <button onclick="numpadPress('2')" class="p-2.5 rounded-lg border <%= isDark ? 'bg-slate-800 border-slate-700 hover:bg-slate-700 text-white' : 'bg-white border-slate-200 hover:bg-slate-100 text-slate-800' %> active:scale-90 transition">2</button>
          <button onclick="numpadPress('3')" class="p-2.5 rounded-lg border <%= isDark ? 'bg-slate-800 border-slate-700 hover:bg-slate-700 text-white' : 'bg-white border-slate-200 hover:bg-slate-100 text-slate-800' %> active:scale-90 transition">3</button>
          <button onclick="quickDiscountApply(5)" class="p-2.5 rounded-lg border <%= isDark ? 'bg-indigo-900/40 border-indigo-700 text-indigo-300' : 'bg-indigo-50 border-indigo-200 text-indigo-700' %> active:scale-90 text-xs">5%</button>

          <button onclick="numpadPress('4')" class="p-2.5 rounded-lg border <%= isDark ? 'bg-slate-800 border-slate-700 hover:bg-slate-700 text-white' : 'bg-white border-slate-200 hover:bg-slate-100 text-slate-800' %> active:scale-90 transition">4</button>
          <button onclick="numpadPress('5')" class="p-2.5 rounded-lg border <%= isDark ? 'bg-slate-800 border-slate-700 hover:bg-slate-700 text-white' : 'bg-white border-slate-200 hover:bg-slate-100 text-slate-800' %> active:scale-90 transition">5</button>
          <button onclick="numpadPress('6')" class="p-2.5 rounded-lg border <%= isDark ? 'bg-slate-800 border-slate-700 hover:bg-slate-700 text-white' : 'bg-white border-slate-200 hover:bg-slate-100 text-slate-800' %> active:scale-90 transition">6</button>
          <button onclick="quickDiscountApply(10)" class="p-2.5 rounded-lg border <%= isDark ? 'bg-indigo-900/40 border-indigo-700 text-indigo-300' : 'bg-indigo-50 border-indigo-200 text-indigo-700' %> active:scale-90 text-xs">10%</button>

          <button onclick="numpadPress('7')" class="p-2.5 rounded-lg border <%= isDark ? 'bg-slate-800 border-slate-700 hover:bg-slate-700 text-white' : 'bg-white border-slate-200 hover:bg-slate-100 text-slate-800' %> active:scale-90 transition">7</button>
          <button onclick="numpadPress('8')" class="p-2.5 rounded-lg border <%= isDark ? 'bg-slate-800 border-slate-700 hover:bg-slate-700 text-white' : 'bg-white border-slate-200 hover:bg-slate-100 text-slate-800' %> active:scale-90 transition">8</button>
          <button onclick="numpadPress('9')" class="p-2.5 rounded-lg border <%= isDark ? 'bg-slate-800 border-slate-700 hover:bg-slate-700 text-white' : 'bg-white border-slate-200 hover:bg-slate-100 text-slate-800' %> active:scale-90 transition">9</button>
          <button onclick="quickDiscountApply(20)" class="p-2.5 rounded-lg border <%= isDark ? 'bg-indigo-900/40 border-indigo-700 text-indigo-300' : 'bg-indigo-50 border-indigo-200 text-indigo-700' %> active:scale-90 text-xs">20%</button>

          <button onclick="numpadPress('C')" class="p-2.5 rounded-lg border <%= isDark ? 'bg-red-900/30 border-red-800 text-red-400' : 'bg-red-50 border-red-200 text-red-600' %> active:scale-90 transition text-xs">CLR</button>
          <button onclick="numpadPress('0')" class="p-2.5 rounded-lg border <%= isDark ? 'bg-slate-800 border-slate-700 hover:bg-slate-700 text-white' : 'bg-white border-slate-200 hover:bg-slate-100 text-slate-800' %> active:scale-90 transition">0</button>
          <button onclick="numpadPress('.')" class="p-2.5 rounded-lg border <%= isDark ? 'bg-slate-800 border-slate-700 hover:bg-slate-700 text-white' : 'bg-white border-slate-200 hover:bg-slate-100 text-slate-800' %> active:scale-90 transition">.</button>
          <button onclick="numpadPress('BACK')" class="p-2.5 rounded-lg border <%= isDark ? 'bg-slate-800 border-slate-700 hover:bg-slate-700 text-white' : 'bg-white border-slate-200 hover:bg-slate-100 text-slate-800' %> active:scale-90 transition">⌫</button>
        </div>
      </div>
    <% } %>

    <!-- Cart Financials Summary & Touch Checkout Trigger -->
    <div class="p-4 border-t <%= isDark ? 'border-slate-800 bg-slate-950/80' : 'border-slate-100 bg-slate-50/70' %> space-y-2 text-xs">
      <div class="flex justify-between <%= isDark ? 'text-slate-400' : 'text-slate-600' %>">
        <span>Subtotal</span>
        <span id="cartSubtotal" class="font-bold"><%= currentStore.currency %>0.00</span>
      </div>

      <div class="flex justify-between items-center <%= isDark ? 'text-slate-400' : 'text-slate-600' %>">
        <span>Discount Applied</span>
        <span id="cartDiscountDisplay" class="font-bold text-emerald-600">-<%= currentStore.currency %>0.00</span>
      </div>

      <% if (currentStore.taxRate > 0) { %>
        <div class="flex justify-between <%= isDark ? 'text-slate-400' : 'text-slate-600' %>">
          <span>Store Tax (<%= currentStore.taxRate %>%)</span>
          <span id="cartTax" class="font-bold"><%= currentStore.currency %>0.00</span>
        </div>
      <% } %>

      <!-- Big Total Display -->
      <div class="pt-2 border-t <%= isDark ? 'border-slate-800' : 'border-slate-200' %> flex justify-between items-baseline">
        <span class="text-sm font-black <%= isDark ? 'text-white' : 'text-slate-900' %>">TOTAL</span>
        <span id="cartTotal" class="text-2xl font-black text-emerald-600"><%= currentStore.currency %>0.00</span>
      </div>

      <!-- Touch Checkout / Sub Total Button (Navigates to Dedicated Discounts & Payment Page) -->
      <button onclick="goToPaymentPage()" id="btnCheckout" disabled
        class="w-full mt-2 <%= btnSizeClass %> px-4 rounded-xl font-black text-white shadow-lg transition active:scale-95 disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer flex items-center justify-between bg-emerald-600 hover:bg-emerald-500">
        <div class="flex items-center space-x-2">
          <i data-lucide="calculator" class="w-5 h-5"></i>
          <span class="text-sm font-black tracking-wide">SUB TOTAL</span>
        </div>
        <div class="flex items-center space-x-1.5 font-mono">
          <span id="btnSubtotalDisplay" class="text-base font-black"><%= currentStore.currency %>0.00</span>
