<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Receipt #<%= sale.receiptNumber %></title>
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  <script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.5/dist/JsBarcode.all.min.js"></script>
  <style>
    @media print {
      body {
        margin: 0;
        padding: 0;
        background: #fff;
      }
      .no-print {
        display: none !important;
      }
    }
  </style>
</head>
<body class="bg-slate-100 min-h-screen py-8 flex flex-col items-center justify-center font-mono">

  <!-- Printable Actions (hidden on print) -->
  <div class="mb-4 no-print flex items-center space-x-3">
    <button onclick="window.print()" class="px-4 py-2 bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold rounded-xl shadow-md cursor-pointer flex items-center gap-1.5">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path></svg>
      Print Receipt
    </button>
    <a href="/pos" class="px-4 py-2 bg-white border border-slate-200 text-slate-700 text-xs font-medium rounded-xl hover:bg-slate-50">
      Back to POS
    </a>
  </div>

  <!-- Thermal 80mm Receipt Container -->
  <div class="w-[330px] bg-white p-6 shadow-xl border border-slate-200 text-slate-900 text-xs leading-relaxed">
    <!-- Store Header -->
    <div class="text-center pb-3 border-b border-dashed border-slate-300 space-y-1">
      <h1 class="text-base font-black tracking-tight uppercase"><%= currentStore.name %></h1>
      <% if (currentStore.address) { %>
        <p class="text-[11px] text-slate-600"><%= currentStore.address %></p>
      <% } %>
      <% if (currentStore.phone) { %>
        <p class="text-[11px] text-slate-600">Tel: <%= currentStore.phone %></p>
      <% } %>
      <% if (currentStore.email) { %>
        <p class="text-[11px] text-slate-600"><%= currentStore.email %></p>
      <% } %>

      <!-- Custom Store Header Message -->
      <% if (currentStore.receiptSettings && currentStore.receiptSettings.headerMessage) { %>
        <p class="text-[10px] text-slate-500 italic pt-1"><%= currentStore.receiptSettings.headerMessage %></p>
      <% } %>
    </div>

    <!-- Transaction Meta -->
    <div class="py-2.5 border-b border-dashed border-slate-300 text-[11px] space-y-1">
      <div class="flex justify-between">
        <span class="text-slate-500">Receipt No:</span>
        <span class="font-bold"><%= sale.receiptNumber %></span>
      </div>
      <div class="flex justify-between">
        <span class="text-slate-500">Date:</span>
        <span><%= formatDateTime(sale.createdAt) %></span>
      </div>
      <div class="flex justify-between">
        <span class="text-slate-500">Cashier:</span>
        <span><%= sale.cashier ? sale.cashier.name : 'Store Staff' %></span>
      </div>
      <div class="flex justify-between">
        <span class="text-slate-500">Customer:</span>
        <span class="truncate max-w-[170px]"><%= sale.customerName %></span>
      </div>
    </div>

    <!-- Items List -->
    <div class="py-3 border-b border-dashed border-slate-300">
      <div class="flex justify-between text-[10px] font-bold uppercase text-slate-400 pb-1.5 mb-1.5 border-b border-slate-100">
        <span class="w-1/2">Item</span>
        <span class="w-1/6 text-center">Qty</span>
        <span class="w-1/3 text-right">Total</span>
      </div>
      <div class="space-y-1.5 text-[11px]">
        <% sale.items.forEach(item => { %>
          <div class="flex justify-between items-start">
            <div class="w-1/2 pr-1">
              <span class="font-bold text-slate-800 block leading-tight"><%= item.name %></span>
              <span class="text-[9px] text-slate-400 font-mono">@ <%= formatMoney(item.unitPrice) %></span>
            </div>
            <span class="w-1/6 text-center font-semibold text-slate-700"><%= item.quantity %></span>
            <span class="w-1/3 text-right font-bold text-slate-900"><%= formatMoney(item.subtotal) %></span>
          </div>
        <% }) %>
      </div>
    </div>

    <!-- Payment Totals -->
    <div class="py-2.5 border-b border-dashed border-slate-300 space-y-1.5 text-[11px]">
      <div class="flex justify-between text-slate-600">
        <span>Subtotal</span>
        <span><%= formatMoney(sale.subtotal) %></span>
      </div>

      <% if (sale.discountAmount > 0) { %>
        <div class="flex justify-between text-emerald-600">
          <span>Discount Applied</span>
          <span>-<%= formatMoney(sale.discountAmount) %></span>
        </div>
      <% } %>

      <% if (sale.taxAmount > 0) { %>
        <div class="flex justify-between text-slate-600">
          <span>Tax (<%= sale.taxRate %>%)</span>
          <span><%= formatMoney(sale.taxAmount) %></span>
        </div>
      <% } %>

      <div class="flex justify-between items-baseline pt-1.5 border-t border-slate-200 text-sm font-black">
        <span>TOTAL DUE</span>
        <span><%= formatMoney(sale.total) %></span>
      </div>

      <div class="flex justify-between text-slate-500 pt-1 text-[10px]">
        <span>Payment Method</span>
        <span class="uppercase font-bold text-slate-700"><%= sale.paymentMethod %></span>
      </div>

      <% if (sale.paymentMethod === 'cash') { %>
        <div class="flex justify-between text-slate-500 text-[10px]">
          <span>Cash Tendered</span>
          <span><%= formatMoney(sale.cashReceived) %></span>
        </div>
        <div class="flex justify-between text-slate-800 font-bold text-[11px]">
          <span>Change Returned</span>
          <span><%= formatMoney(sale.changeGiven) %></span>
        </div>
      <% } %>
    </div>

    <!-- Receipt Footer & Barcode -->
    <div class="text-center pt-3 space-y-2">
      <% if (currentStore.receiptSettings && currentStore.receiptSettings.footerMessage) { %>
        <p class="text-[10px] text-slate-500 italic"><%= currentStore.receiptSettings.footerMessage %></p>
      <% } %>

      <!-- Barcode representation of Receipt Number -->
      <% if (!currentStore.receiptSettings || currentStore.receiptSettings.showBarcode !== false) { %>
        <div class="pt-1 flex flex-col items-center">
          <svg id="receiptBarcode" class="w-full h-9"></svg>
          <span class="text-[9px] font-mono tracking-widest text-slate-500"><%= sale.receiptNumber %></span>
        </div>
      <% } %>

      <p class="text-[9px] text-slate-400">Powered by StockPlus</p>
    </div>
  </div>

  <script>
    try {
      JsBarcode("#receiptBarcode", "<%= sale.receiptNumber %>", {
        format: "CODE128",
        width: 1.3,
        height: 32,
        displayValue: false,
        margin: 0
      });
    } catch(e) {
      console.error(e);
    }
  </script>
</body>
</html>

