<div class="max-w-3xl mx-auto space-y-6">
  <!-- Header -->
  <div>
    <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Product Categories</h1>
    <p class="text-slate-500 text-xs mt-1">Organize your store catalog with categorized color-coded tags.</p>
  </div>

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="p-3.5 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-700 text-xs flex items-center">
      <i data-lucide="check-circle" class="w-4 h-4 mr-2 flex-shrink-0"></i>
      <span><%= success %></span>
    </div>
  <% } %>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="p-3.5 rounded-xl bg-red-50 border border-red-200 text-red-600 text-xs flex items-center">
      <i data-lucide="alert-circle" class="w-4 h-4 mr-2 flex-shrink-0"></i>
      <span><%= error %></span>
    </div>
  <% } %>

  <!-- Add Category Card -->
  <div class="bg-white rounded-2xl border border-slate-200/80 shadow-2xs p-6 space-y-4">
    <h2 class="text-xs font-bold uppercase tracking-wider text-slate-700 flex items-center">
      <i data-lucide="plus" class="w-4 h-4 mr-1.5 text-blue-500"></i>
      Create Category
    </h2>

    <form action="/settings/categories" method="POST" class="grid grid-cols-1 sm:grid-cols-3 gap-4 items-end">
      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">Category Name *</label>
        <input type="text" name="name" required placeholder="e.g. Dairy, Outerwear, Accessories"
          class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs focus:outline-none focus:ring-1 focus:ring-blue-500 transition">
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">Badge Tag Color</label>
        <div class="flex items-center space-x-2">
          <input type="color" name="color" value="#3b82f6"
            class="h-10 w-16 rounded-xl border border-slate-200 cursor-pointer p-0.5">
          <span class="text-[11px] text-slate-400">Badge accent</span>
        </div>
      </div>

      <div>
        <button type="submit" class="w-full py-2.5 px-4 rounded-xl text-xs font-semibold text-white shadow-sm transition hover:opacity-95" style="background-color: <%= brandColor %>;">
          Add Category
        </button>
      </div>

      <div class="sm:col-span-3">
        <label class="block text-xs font-semibold text-slate-700 mb-1">Description (Optional)</label>
        <input type="text" name="description" placeholder="Brief note about what belongs in this category"
          class="w-full px-3.5 py-2 rounded-xl border border-slate-200 text-xs focus:outline-none focus:ring-1 focus:ring-blue-500 transition">
      </div>
    </form>
  </div>

  <!-- Categories Table -->
  <div class="bg-white rounded-2xl border border-slate-200/80 shadow-2xs overflow-hidden">
    <div class="px-6 py-4 border-b border-slate-100">
      <h2 class="text-xs font-bold uppercase tracking-wider text-slate-700">Existing Categories (<%= categories.length %>)</h2>
    </div>

    <% if (categories && categories.length > 0) { %>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="bg-slate-50 text-slate-500 uppercase tracking-wider text-[10px] border-b border-slate-100">
            <tr>
              <th class="py-3 px-6">Badge / Name</th>
              <th class="py-3 px-3">Description</th>
              <th class="py-3 px-6 text-right">Action</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% categories.forEach(cat => { %>
              <tr class="hover:bg-slate-50/70 transition">
                <td class="py-3 px-6">
                  <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold shadow-2xs"
                    style="background-color: <%= cat.color %>18; color: <%= cat.color %>; border: 1px solid <%= cat.color %>30;">
                    <span class="w-2 h-2 rounded-full mr-1.5" style="background-color: <%= cat.color %>;"></span>
                    <%= cat.name %>
                  </span>
                </td>

                <td class="py-3 px-3 text-slate-500">
                  <%= cat.description || '-' %>
                </td>

                <td class="py-3 px-6 text-right whitespace-nowrap">
                  <form action="/settings/categories/<%= cat._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Delete category <%= cat.name %>?');">
                    <button type="submit" class="p-1 text-slate-400 hover:text-red-600">
                      <i data-lucide="trash-2" class="w-4 h-4"></i>
                    </button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="text-center py-10 text-slate-400 text-xs">
        No categories created yet.
      </div>
    <% } %>
  </div>
</div>

