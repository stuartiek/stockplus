<div class="max-w-3xl mx-auto space-y-6">
  <!-- Header -->
  <div>
    <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Store Branding & Operational Settings</h1>
    <p class="text-slate-500 text-xs mt-1">Configure your store's identity, currency, tax rates, theme accent, and receipt layout.</p>
  </div>

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="p-3.5 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-700 text-xs flex items-center">
      <i data-lucide="check-circle" class="w-4 h-4 mr-2 flex-shrink-0"></i>
      <span><%= success %></span>
    </div>
  <% } %>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="p-3.5 rounded-xl bg-red-50 border border-red-200 text-red-600 text-xs flex items-center">
      <i data-lucide="alert-circle" class="w-4 h-4 mr-2 flex-shrink-0"></i>
      <span><%= error %></span>
    </div>
  <% } %>

  <form action="/settings/store?_method=PUT" method="POST" class="space-y-6">
    <!-- Card 1: Identity & Currency -->
    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-2xs p-6 space-y-4">
      <h2 class="text-xs font-semibold uppercase tracking-wider text-slate-500 flex items-center">
        <i data-lucide="store" class="w-3.5 h-3.5 mr-1.5 text-blue-500"></i>
        Store Identity & Currency
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="md:col-span-2">
          <label class="block text-xs font-semibold text-slate-700 mb-1">Store / Business Name *</label>
          <input type="text" name="name" required value="<%= currentStore.name %>"
            class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs focus:outline-none focus:ring-1 focus:ring-blue-500 transition">
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Currency Symbol</label>
          <input type="text" name="currency" required value="<%= currentStore.currency %>"
            class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs font-bold focus:outline-none focus:ring-1 focus:ring-blue-500 transition">
          <p class="text-[10px] text-slate-400 mt-1">e.g. $, £, €, ₹, ₦, ¥</p>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Currency Code</label>
          <input type="text" name="currencyCode" required value="<%= currentStore.currencyCode %>"
            class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs font-mono uppercase focus:outline-none focus:ring-1 focus:ring-blue-500 transition">
          <p class="text-[10px] text-slate-400 mt-1">e.g. USD, GBP, EUR, INR</p>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Default Store Tax Rate (%)</label>
          <input type="number" step="0.1" min="0" max="100" name="taxRate" value="<%= currentStore.taxRate %>"
            class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs focus:outline-none focus:ring-1 focus:ring-blue-500 transition">
          <p class="text-[10px] text-slate-400 mt-1">Automatically computed at POS checkout (0 for no tax).</p>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Default Low Stock Alert Threshold</label>
          <input type="number" step="1" min="0" name="lowStockThreshold" value="<%= currentStore.lowStockThreshold %>"
            class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs focus:outline-none focus:ring-1 focus:ring-blue-500 transition">
          <p class="text-[10px] text-slate-400 mt-1">Default quantity when products show reorder warnings.</p>
        </div>
      </div>
    </div>

    <!-- Card 2: Visual Branding & Accent Color -->
    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-2xs p-6 space-y-4">
      <h2 class="text-xs font-semibold uppercase tracking-wider text-slate-500 flex items-center">
        <i data-lucide="palette" class="w-3.5 h-3.5 mr-1.5 text-purple-500"></i>
        Theme Accent & Store Colors
      </h2>

      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-2">Primary Brand Theme Color</label>
        <div class="flex items-center space-x-4">
          <input type="color" name="brandColor" id="colorPicker" value="<%= currentStore.brandColor || '#2563eb' %>"
            class="h-10 w-20 rounded-xl border border-slate-200 cursor-pointer p-0.5">
          <div class="flex flex-wrap gap-2">
            <button type="button" onclick="setBrandColor('#2563eb')" class="w-6 h-6 rounded-full bg-blue-600 border-2 border-white shadow-xs" title="Blue"></button>
            <button type="button" onclick="setBrandColor('#059669')" class="w-6 h-6 rounded-full bg-emerald-600 border-2 border-white shadow-xs" title="Emerald"></button>
            <button type="button" onclick="setBrandColor('#4f46e5')" class="w-6 h-6 rounded-full bg-indigo-600 border-2 border-white shadow-xs" title="Indigo"></button>
            <button type="button" onclick="setBrandColor('#7c3aed')" class="w-6 h-6 rounded-full bg-violet-600 border-2 border-white shadow-xs" title="Violet"></button>
            <button type="button" onclick="setBrandColor('#d97706')" class="w-6 h-6 rounded-full bg-amber-600 border-2 border-white shadow-xs" title="Amber"></button>
            <button type="button" onclick="setBrandColor('#e11d48')" class="w-6 h-6 rounded-full bg-rose-600 border-2 border-white shadow-xs" title="Rose"></button>
            <button type="button" onclick="setBrandColor('#0f172a')" class="w-6 h-6 rounded-full bg-slate-900 border-2 border-white shadow-xs" title="Slate"></button>
          </div>
        </div>
        <p class="text-[11px] text-slate-400 mt-2">Drives primary buttons, active highlights, and thermal receipt headers.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Store Phone</label>
          <input type="text" name="phone" value="<%= currentStore.phone || '' %>" placeholder="+1 (555) 234-5678"
            class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs focus:outline-none focus:ring-1 focus:ring-blue-500 transition">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Store Support Email</label>
          <input type="email" name="email" value="<%= currentStore.email || '' %>" placeholder="contact@mystore.com"
            class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs focus:outline-none focus:ring-1 focus:ring-blue-500 transition">
        </div>
        <div class="md:col-span-2">
          <label class="block text-xs font-semibold text-slate-700 mb-1">Store Address (Printed on Receipts)</label>
          <input type="text" name="address" value="<%= currentStore.address || '' %>" placeholder="123 High Street, Downtown"
            class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs focus:outline-none focus:ring-1 focus:ring-blue-500 transition">
        </div>
      </div>
    </div>

    <!-- Card 3: Thermal Receipt Customizer -->
    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-2xs p-6 space-y-4">
      <h2 class="text-xs font-semibold uppercase tracking-wider text-slate-500 flex items-center">
        <i data-lucide="receipt" class="w-3.5 h-3.5 mr-1.5 text-emerald-500"></i>
        Thermal Receipt Customizer
      </h2>

      <div class="space-y-4">
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Receipt Header Greeting</label>
          <input type="text" name="headerMessage" value="<%= currentStore.receiptSettings ? currentStore.receiptSettings.headerMessage : 'Thank you for shopping with us!' %>"
            class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs focus:outline-none focus:ring-1 focus:ring-blue-500 transition">
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Receipt Footer Note / Return Policy</label>
          <textarea name="footerMessage" rows="2"
            class="w-full px-3.5 py-2 rounded-xl border border-slate-200 text-xs focus:outline-none focus:ring-1 focus:ring-blue-500 transition"><%= currentStore.receiptSettings ? currentStore.receiptSettings.footerMessage : 'Please retain receipt for returns.' %></textarea>
        </div>

        <div class="flex items-center space-x-6 pt-2">
          <label class="flex items-center space-x-2 cursor-pointer">
            <input type="checkbox" name="showTax" <%= (!currentStore.receiptSettings || currentStore.receiptSettings.showTax) ? 'checked' : '' %>
              class="w-4 h-4 rounded text-blue-600 focus:ring-blue-500">
            <span class="text-xs text-slate-700 font-medium">Show Tax Breakdown on Receipt</span>
          </label>

          <label class="flex items-center space-x-2 cursor-pointer">
            <input type="checkbox" name="showBarcode" <%= (!currentStore.receiptSettings || currentStore.receiptSettings.showBarcode) ? 'checked' : '' %>
              class="w-4 h-4 rounded text-blue-600 focus:ring-blue-500">
            <span class="text-xs text-slate-700 font-medium">Print Receipt Barcode</span>
          </label>
        </div>
      </div>
    </div>

    <!-- Submit Button -->
    <div class="flex items-center justify-end space-x-3 pt-2">
      <button type="submit" class="px-6 py-2.5 rounded-xl font-semibold text-xs text-white shadow-sm transition hover:opacity-95" style="background-color: <%= brandColor %>;">
        Save All Settings
      </button>
    </div>
  </form>
</div>

<script>
  function setBrandColor(color) {
    document.getElementById('colorPicker').value = color;
  }
</script>

