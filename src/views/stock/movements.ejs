<div class="space-y-6">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Stock Movement Ledger</h1>
      <p class="text-slate-500 text-xs mt-1">Full audit trail of all inventory inputs, deductions, damages, and cycle counts.</p>
    </div>
    <div class="flex items-center space-x-2.5">
      <a href="/stock/adjust" class="inline-flex items-center px-3.5 py-2 rounded-xl text-xs font-semibold text-white shadow-xs transition hover:opacity-95" style="background-color: <%= brandColor %>;">
        <i data-lucide="sliders" class="w-4 h-4 mr-1.5"></i>
        New Stock Adjustment
      </a>
    </div>
  </div>

  <!-- Filter Bar -->
  <div class="bg-white p-4 rounded-2xl border border-slate-200/80 shadow-2xs">
    <form action="/stock/movements" method="GET" class="grid grid-cols-1 sm:grid-cols-3 gap-3">
      <!-- Movement Type Filter -->
      <div>
        <label class="block text-[11px] font-semibold text-slate-500 uppercase tracking-wider mb-1">Movement Type</label>
        <select name="type" onchange="this.form.submit()"
          class="w-full px-3 py-2 rounded-xl border border-slate-200 text-xs focus:outline-none focus:ring-1 focus:ring-blue-500 transition">
          <option value="">All Movement Types</option>
          <option value="purchase_in" <%= filters.type === 'purchase_in' ? 'selected' : '' %>>Purchase / Stock In (+)</option>
          <option value="sale_out" <%= filters.type === 'sale_out' ? 'selected' : '' %>>Sale Out (-)</option>
          <option value="damage_loss" <%= filters.type === 'damage_loss' ? 'selected' : '' %>>Damage / Loss (-)</option>
          <option value="return_in" <%= filters.type === 'return_in' ? 'selected' : '' %>>Customer Return (+)</option>
          <option value="adjustment" <%= filters.type === 'adjustment' ? 'selected' : '' %>>Manual Adjustment</option>
        </select>
      </div>

      <!-- Product Filter -->
      <div>
        <label class="block text-[11px] font-semibold text-slate-500 uppercase tracking-wider mb-1">Filter by Product</label>
        <select name="productId" onchange="this.form.submit()"
          class="w-full px-3 py-2 rounded-xl border border-slate-200 text-xs focus:outline-none focus:ring-1 focus:ring-blue-500 transition">
          <option value="">All Products</option>
          <% products.forEach(prod => { %>
            <option value="<%= prod._id %>" <%= filters.productId == prod._id.toString() ? 'selected' : '' %>>
              <%= prod.name %> (<%= prod.sku %>)
            </option>
          <% }) %>
        </select>
      </div>

      <!-- Action -->
      <div class="flex items-end space-x-2">
        <button type="submit" class="flex-1 py-2 px-3 rounded-xl bg-slate-900 text-white text-xs font-semibold hover:bg-slate-800 transition">
          Apply Filter
        </button>
        <% if (filters.type || filters.productId) { %>
          <a href="/stock/movements" class="py-2 px-3 rounded-xl border border-slate-200 text-slate-600 text-xs hover:bg-slate-50 transition" title="Clear Filters">
            <i data-lucide="x" class="w-4 h-4"></i>
          </a>
        <% } %>
      </div>
    </form>
  </div>

  <!-- Movements Table -->
  <div class="bg-white rounded-2xl border border-slate-200/80 shadow-2xs overflow-hidden">
    <% if (movements && movements.length > 0) { %>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="bg-slate-50 text-slate-500 uppercase tracking-wider text-[10px] border-b border-slate-100">
            <tr>
              <th class="py-3 px-4">Date & Time</th>
              <th class="py-3 px-4">Product / SKU</th>
              <th class="py-3 px-3">Type</th>
              <th class="py-3 px-3 text-right">Previous</th>
              <th class="py-3 px-3 text-right">Change</th>
              <th class="py-3 px-3 text-right">New Stock</th>
              <th class="py-3 px-4">Reason / Reference</th>
              <th class="py-3 px-4">Authorized By</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% movements.forEach(m => { %>
              <tr class="hover:bg-slate-50/70 transition">
                <td class="py-3 px-4 text-slate-500 font-mono whitespace-nowrap"><%= formatDateTime(m.createdAt) %></td>
                
                <td class="py-3 px-4">
                  <% if (m.product) { %>
                    <a href="/products/<%= m.product._id %>" class="font-bold text-slate-900 hover:text-blue-600 block">
                      <%= m.product.name %>
                    </a>
                    <span class="text-[11px] text-slate-400 font-mono"><%= m.product.sku %></span>
                  <% } else { %>
                    <span class="text-slate-400">Archived Product</span>
                  <% } %>
                </td>

                <td class="py-3 px-3">
                  <% if (m.type === 'purchase_in') { %>
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800">
                      Stock In (Purchase)
                    </span>
                  <% } else if (m.type === 'sale_out') { %>
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-blue-100 text-blue-800">
                      Sale Out
                    </span>
                  <% } else if (m.type === 'damage_loss') { %>
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-red-100 text-red-800">
                      Damage / Loss
                    </span>
                  <% } else if (m.type === 'return_in') { %>
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-purple-100 text-purple-800">
                      Customer Return
                    </span>
                  <% } else { %>
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-slate-100 text-slate-800">
                      Adjustment
                    </span>
                  <% } %>
                </td>

                <td class="py-3 px-3 text-right text-slate-500 font-medium"><%= m.previousStock %></td>

                <td class="py-3 px-3 text-right font-black <%= m.quantity > 0 ? 'text-emerald-600' : 'text-red-600' %>">
                  <%= m.quantity > 0 ? '+' : '' %><%= m.quantity %>
                </td>

                <td class="py-3 px-3 text-right font-bold text-slate-900"><%= m.newStock %></td>

                <td class="py-3 px-4 text-slate-600">
                  <div class="truncate max-w-xs font-medium"><%= m.reason || '-' %></div>
                  <% if (m.referenceId) { %>
                    <span class="text-[10px] text-slate-400 font-mono">Ref: <%= m.referenceId %></span>
                  <% } %>
                </td>

                <td class="py-3 px-4 text-slate-600 whitespace-nowrap">
                  <%= m.performedBy ? m.performedBy.name : 'System' %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <!-- Pagination Footer -->
      <div class="px-4 py-3 bg-slate-50/50 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
        <span>Showing <%= movements.length %> of <%= totalCount %> recorded events</span>
        <div class="flex items-center space-x-2">
          <% if (currentPage > 1) { %>
            <a href="?page=<%= currentPage - 1 %><%= filters.type ? '&type=' + filters.type : '' %><%= filters.productId ? '&productId=' + filters.productId : '' %>"
              class="px-3 py-1 rounded-lg border border-slate-200 bg-white hover:bg-slate-50">
              Previous
            </a>
          <% } %>
          <span>Page <%= currentPage %> of <%= totalPages %></span>
          <% if (currentPage < totalPages) { %>
            <a href="?page=<%= currentPage + 1 %><%= filters.type ? '&type=' + filters.type : '' %><%= filters.productId ? '&productId=' + filters.productId : '' %>"
              class="px-3 py-1 rounded-lg border border-slate-200 bg-white hover:bg-slate-50">
              Next
            </a>
          <% } %>
        </div>
      </div>
    <% } else { %>
      <div class="text-center py-12 px-4">
        <i data-lucide="history" class="w-10 h-10 mx-auto text-slate-400 mb-2"></i>
        <h3 class="text-sm font-bold text-slate-800">No stock movements recorded</h3>
        <p class="text-xs text-slate-500 mt-1">Movements occur automatically during POS checkouts, PO receiving, or manual adjustments.</p>
      </div>
    <% } %>
  </div>
</div>

