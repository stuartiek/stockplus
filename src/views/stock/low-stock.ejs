<div class="space-y-6">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold text-slate-900 tracking-tight flex items-center gap-2">
        <i data-lucide="alert-triangle" class="w-6 h-6 text-amber-500"></i>
        Low Stock & Restock Alert Center
      </h1>
      <p class="text-slate-500 text-xs mt-1">
        Items requiring reordering based on their individual threshold or store default (<%= defaultThreshold %> units).
      </p>
    </div>
    <div class="flex items-center space-x-2.5">
      <a href="/purchase-orders/new" class="inline-flex items-center px-3.5 py-2 rounded-xl text-xs font-semibold text-white shadow-xs transition hover:opacity-95" style="background-color: <%= brandColor %>;">
        <i data-lucide="truck" class="w-4 h-4 mr-1.5"></i>
        Draft Purchase Order
      </a>
    </div>
  </div>

  <!-- Low Stock Table -->
  <div class="bg-white rounded-2xl border border-slate-200/80 shadow-2xs overflow-hidden">
    <% if (lowStockProducts && lowStockProducts.length > 0) { %>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="bg-slate-50 text-slate-500 uppercase tracking-wider text-[10px] border-b border-slate-100">
            <tr>
              <th class="py-3 px-4">Product / SKU</th>
              <th class="py-3 px-3">Category</th>
              <th class="py-3 px-3">Supplier</th>
              <th class="py-3 px-3 text-right">In Stock</th>
              <th class="py-3 px-3 text-right">Threshold</th>
              <th class="py-3 px-3 text-right">Cost Value</th>
              <th class="py-3 px-4 text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% lowStockProducts.forEach(p => { %>
              <tr class="hover:bg-slate-50/70 transition">
                <td class="py-3 px-4">
                  <a href="/products/<%= p._id %>" class="font-bold text-slate-900 hover:text-blue-600 block">
                    <%= p.name %>
                  </a>
                  <span class="text-[11px] text-slate-400 font-mono"><%= p.sku %></span>
                </td>

                <td class="py-3 px-3">
                  <% if (p.category) { %>
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold" style="background-color: <%= p.category.color %>20; color: <%= p.category.color %>;">
                      <%= p.category.name %>
                    </span>
                  <% } else { %>
                    <span class="text-slate-400">-</span>
                  <% } %>
                </td>

                <td class="py-3 px-3 text-slate-600">
                  <% if (p.supplier) { %>
                    <a href="/suppliers/<%= p.supplier._id %>" class="hover:underline text-blue-600 font-medium">
                      <%= p.supplier.name %>
                    </a>
                  <% } else { %>
                    <span class="text-slate-400">None</span>
                  <% } %>
                </td>

                <td class="py-3 px-3 text-right">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold <%= p.currentStock <= 0 ? 'bg-red-100 text-red-700' : 'bg-amber-100 text-amber-800' %>">
                    <%= p.currentStock %> <%= p.unit %>
                  </span>
                </td>

                <td class="py-3 px-3 text-right font-medium text-slate-600">
                  <%= p.reorderLevel %> <%= p.unit %>
                </td>

                <td class="py-3 px-3 text-right text-slate-500 font-medium">
                  <%= formatMoney(p.costPrice) %>
                </td>

                <td class="py-3 px-4 text-right whitespace-nowrap">
                  <div class="flex items-center justify-end space-x-2">
                    <a href="/stock/adjust?productId=<%= p._id %>" class="px-2.5 py-1 rounded-lg border border-slate-200 text-xs font-medium text-slate-700 hover:bg-slate-50">
                      Restock Intake
                    </a>
                    <a href="/purchase-orders/new?supplierId=<%= p.supplier ? p.supplier._id : '' %>" class="px-2.5 py-1 rounded-lg bg-slate-900 text-white text-xs font-medium hover:bg-slate-800">
                      Order More
                    </a>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <div class="px-4 py-3 bg-amber-50/50 border-t border-amber-100 text-xs text-amber-800 flex items-center justify-between">
        <span><strong><%= lowStockProducts.length %></strong> products need replenishment.</span>
        <span>Reorder promptly to prevent stockouts at checkout.</span>
      </div>
    <% } else { %>
      <div class="text-center py-16 px-4">
        <div class="w-14 h-14 bg-emerald-50 text-emerald-600 rounded-2xl flex items-center justify-center mx-auto mb-3">
          <i data-lucide="check-circle" class="w-8 h-8"></i>
        </div>
        <h3 class="text-base font-bold text-slate-800">All Stock Levels Optimal</h3>
        <p class="text-xs text-slate-500 mt-1">Every item currently in the catalog is stocked above its reorder threshold.</p>
      </div>
    <% } %>
  </div>
</div>

