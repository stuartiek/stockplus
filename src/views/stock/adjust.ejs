<div class="max-w-2xl mx-auto space-y-6">
  <!-- Header -->
  <div>
    <a href="/stock/movements" class="inline-flex items-center text-xs text-slate-500 hover:text-slate-800 mb-1">
      <i data-lucide="arrow-left" class="w-3.5 h-3.5 mr-1"></i>
      Back to Stock Ledger
    </a>
    <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Stock Adjustment & Cycle Count</h1>
    <p class="text-slate-500 text-xs">Accurately record inventory adjustments, waste/damage write-offs, or cycle count findings.</p>
  </div>

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="p-3.5 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-700 text-xs flex items-center">
      <i data-lucide="check-circle" class="w-4 h-4 mr-2 flex-shrink-0"></i>
      <span><%= success %></span>
    </div>
  <% } %>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="p-3.5 rounded-xl bg-red-50 border border-red-200 text-red-600 text-xs flex items-center">
      <i data-lucide="alert-circle" class="w-4 h-4 mr-2 flex-shrink-0"></i>
      <span><%= error %></span>
    </div>
  <% } %>

  <div class="bg-white rounded-2xl border border-slate-200/80 shadow-2xs p-6">
    <form action="/stock/adjust" method="POST" class="space-y-5" id="adjustForm">
      <!-- Product Selection -->
      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1.5">Select Product to Adjust *</label>
        <select name="productId" id="productSelect" required onchange="updateProductStockInfo()"
          class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs focus:outline-none focus:ring-1 focus:ring-blue-500 transition">
          <option value="">-- Choose a Product --</option>
          <% products.forEach(p => { %>
            <option value="<%= p._id %>" 
              data-stock="<%= p.currentStock %>" 
              data-unit="<%= p.unit %>"
              data-sku="<%= p.sku %>"
              <%= (typeof preselectedProductId !== 'undefined' && preselectedProductId == p._id.toString()) ? 'selected' : '' %>>
              <%= p.name %> [SKU: <%= p.sku %>] - Current Stock: <%= p.currentStock %> <%= p.unit %>
            </option>
          <% }) %>
        </select>
      </div>

      <!-- Current Stock Information Badge -->
      <div id="stockInfoBox" class="p-4 rounded-xl bg-slate-50 border border-slate-100 flex items-center justify-between">
        <div>
          <span class="text-[10px] uppercase font-bold text-slate-400 block tracking-wider">Current Physical Stock</span>
          <span id="currentStockDisplay" class="text-xl font-bold text-slate-900">-</span>
        </div>
        <div class="text-right">
          <span class="text-[10px] uppercase font-bold text-slate-400 block tracking-wider">Projected New Stock</span>
          <span id="newStockDisplay" class="text-xl font-bold text-blue-600">-</span>
        </div>
      </div>

      <!-- Adjustment Type -->
      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1.5">Reason Category / Movement Type *</label>
        <select name="type" required id="adjustmentTypeSelect" onchange="calculateProjectedStock()"
          class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs focus:outline-none focus:ring-1 focus:ring-blue-500 transition">
          <option value="adjustment">Cycle Count Audit / Correction (+ or -)</option>
          <option value="purchase_in">Received Unrecorded Stock Intake (+)</option>
          <option value="damage_loss">Damaged, Expired or Lost Goods (-)</option>
          <option value="return_in">Customer Return / Exchange (+)</option>
        </select>
      </div>

      <!-- Quantity Change Input -->
      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1.5">
          Quantity to Change (+ to increase, - to decrease) *
        </label>
        <div class="relative">
          <input type="number" step="1" name="quantityChange" id="qtyChangeInput" required placeholder="e.g. 10 or -5"
            oninput="calculateProjectedStock()"
            class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs font-bold text-slate-900 focus:outline-none focus:ring-1 focus:ring-blue-500 transition">
        </div>
        <p class="text-[11px] text-slate-400 mt-1">
          Example: Enter <code class="text-emerald-600 font-semibold">+15</code> to add 15 units, or <code class="text-red-600 font-semibold">-3</code> to deduct 3 units.
        </p>
      </div>

      <!-- Notes / Reason -->
      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1.5">Audit Note / Reason</label>
        <textarea name="notes" rows="2" placeholder="e.g. Broken during shelf reorganization, monthly physical count discrepancy, batch inspection..."
          class="w-full px-3.5 py-2 rounded-xl border border-slate-200 text-xs focus:outline-none focus:ring-1 focus:ring-blue-500 transition"></textarea>
      </div>

      <div class="pt-3 border-t border-slate-100 flex items-center justify-end space-x-3">
        <a href="/stock/movements" class="px-4 py-2 text-xs font-medium text-slate-600 hover:text-slate-800">Cancel</a>
        <button type="submit" class="px-5 py-2.5 rounded-xl font-semibold text-xs text-white shadow-sm transition hover:opacity-95" style="background-color: <%= brandColor %>;">
          Record Adjustment in Ledger
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  function updateProductStockInfo() {
    const select = document.getElementById('productSelect');
    const selectedOption = select.options[select.selectedIndex];
    
    if (selectedOption && selectedOption.dataset.stock !== undefined) {
      const stock = parseInt(selectedOption.dataset.stock, 10);
      const unit = selectedOption.dataset.unit || 'pcs';
      document.getElementById('currentStockDisplay').textContent = `${stock} ${unit}`;
      calculateProjectedStock();
    } else {
      document.getElementById('currentStockDisplay').textContent = '-';
      document.getElementById('newStockDisplay').textContent = '-';
    }
  }

  function calculateProjectedStock() {
    const select = document.getElementById('productSelect');
    const selectedOption = select.options[select.selectedIndex];
    const qtyInput = document.getElementById('qtyChangeInput');
    
    if (selectedOption && selectedOption.dataset.stock !== undefined) {
      const current = parseInt(selectedOption.dataset.stock, 10) || 0;
      const unit = selectedOption.dataset.unit || 'pcs';
      const change = parseInt(qtyInput.value, 10) || 0;
      const projected = current + change;
      
      const newDisplay = document.getElementById('newStockDisplay');
      newDisplay.textContent = `${projected} ${unit}`;
      if (projected < 0) {
        newDisplay.className = "text-xl font-bold text-red-600";
      } else {
        newDisplay.className = "text-xl font-bold text-blue-600";
      }
    }
  }

  // Auto trigger on page load if preselected
  window.addEventListener('DOMContentLoaded', updateProductStockInfo);
</script>

