<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-50">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'StockPlus - Smart Inventory Management' %></title>
  
  <!-- Tailwind CSS CDN with forms and typography plugins -->
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <!-- JsBarcode -->
  <script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.5/dist/JsBarcode.all.min.js"></script>
  <!-- Chart.js -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <style>
    :root {
      --brand-primary: <%= typeof brandColor !== 'undefined' ? brandColor : '#2563eb' %>;
      --brand-dark: #1e293b;
    }
    .bg-brand {
      background-color: var(--brand-primary);
    }
    .text-brand {
      color: var(--brand-primary);
    }
    .border-brand {
      border-color: var(--brand-primary);
    }
    .hover-bg-brand:hover {
      filter: brightness(0.92);
    }
    /* Custom scrollbar */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #f1f5f9;
    }
    ::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 4px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #94a3b8;
    }
    @media print {
      .no-print {
        display: none !important;
      }
    }
  </style>
</head>
<body class="h-full flex overflow-hidden text-slate-800 antialiased font-sans">

  <% if (typeof currentUser !== 'undefined' && currentUser && typeof currentStore !== 'undefined' && currentStore) { %>
    <!-- SIDEBAR NAVIGATION -->
    <aside class="w-64 bg-slate-900 text-slate-300 flex flex-col flex-shrink-0 z-20 transition-all duration-200 no-print">
      <!-- Store Brand Header -->
      <div class="h-16 flex items-center px-6 border-b border-slate-800 bg-slate-950/60 justify-between">
        <a href="/dashboard" class="flex items-center space-x-3">
          <div class="w-9 h-9 rounded-xl flex items-center justify-center text-white font-bold text-lg shadow-md" style="background-color: <%= brandColor %>;">
            <%= currentStore.name.charAt(0) %>
          </div>
          <div class="overflow-hidden">
            <span class="block font-bold text-white text-sm truncate tracking-tight"><%= currentStore.name %></span>
            <span class="block text-[11px] text-slate-400 capitalize tracking-wider flex items-center gap-1">
              <span class="w-1.5 h-1.5 rounded-full" style="background-color: <%= brandColor %>;"></span>
              <%= currentStore.storeType %> store
            </span>
          </div>
        </a>
      </div>

      <!-- Navigation Links -->
      <nav class="flex-1 px-4 py-4 space-y-1 overflow-y-auto">
        <div class="px-3 pb-2 text-[10px] font-semibold uppercase tracking-wider text-slate-500">Overview</div>
        <a href="/dashboard" class="flex items-center px-3 py-2.5 text-sm font-medium rounded-lg transition-colors <%= currentPath === '/dashboard' ? 'bg-slate-800 text-white' : 'text-slate-400 hover:text-white hover:bg-slate-800/60' %>">
          <i data-lucide="layout-dashboard" class="w-4 h-4 mr-3 <%= currentPath === '/dashboard' ? 'text-brand' : '' %>"></i>
          Dashboard
        </a>
        <a href="/pos" class="flex items-center px-3 py-2.5 text-sm font-medium rounded-lg transition-colors <%= currentPath === '/pos' ? 'bg-slate-800 text-white' : 'text-emerald-400 hover:text-white hover:bg-slate-800/60' %>">
          <i data-lucide="shopping-cart" class="w-4 h-4 mr-3 text-emerald-400"></i>
          Point of Sale (POS)
          <span class="ml-auto bg-emerald-500/20 text-emerald-400 text-[10px] font-bold px-2 py-0.5 rounded-full">Sale</span>
        </a>

        <div class="pt-4 px-3 pb-2 text-[10px] font-semibold uppercase tracking-wider text-slate-500">Inventory & Stock</div>
        <a href="/products" class="flex items-center px-3 py-2.5 text-sm font-medium rounded-lg transition-colors <%= currentPath.startsWith('/products') ? 'bg-slate-800 text-white' : 'text-slate-400 hover:text-white hover:bg-slate-800/60' %>">
          <i data-lucide="package" class="w-4 h-4 mr-3 <%= currentPath.startsWith('/products') ? 'text-brand' : '' %>"></i>
          Products Catalog
        </a>
        <a href="/stock/movements" class="flex items-center px-3 py-2.5 text-sm font-medium rounded-lg transition-colors <%= currentPath === '/stock/movements' ? 'bg-slate-800 text-white' : 'text-slate-400 hover:text-white hover:bg-slate-800/60' %>">
          <i data-lucide="history" class="w-4 h-4 mr-3"></i>
          Stock Ledger / Audit
        </a>
        <a href="/stock/adjust" class="flex items-center px-3 py-2.5 text-sm font-medium rounded-lg transition-colors <%= currentPath === '/stock/adjust' ? 'bg-slate-800 text-white' : 'text-slate-400 hover:text-white hover:bg-slate-800/60' %>">
          <i data-lucide="sliders" class="w-4 h-4 mr-3"></i>
          Stock Adjustment
        </a>
        <a href="/stock/low" class="flex items-center px-3 py-2.5 text-sm font-medium rounded-lg transition-colors <%= currentPath === '/stock/low' ? 'bg-slate-800 text-white' : 'text-slate-400 hover:text-white hover:bg-slate-800/60' %>">
          <i data-lucide="alert-triangle" class="w-4 h-4 mr-3 text-amber-400"></i>
          Low Stock Alerts
        </a>

        <div class="pt-4 px-3 pb-2 text-[10px] font-semibold uppercase tracking-wider text-slate-500">Procurement & Sales</div>
        <a href="/purchase-orders" class="flex items-center px-3 py-2.5 text-sm font-medium rounded-lg transition-colors <%= currentPath.startsWith('/purchase-orders') ? 'bg-slate-800 text-white' : 'text-slate-400 hover:text-white hover:bg-slate-800/60' %>">
          <i data-lucide="truck" class="w-4 h-4 mr-3"></i>
          Purchase Orders
        </a>
        <a href="/suppliers" class="flex items-center px-3 py-2.5 text-sm font-medium rounded-lg transition-colors <%= currentPath.startsWith('/suppliers') ? 'bg-slate-800 text-white' : 'text-slate-400 hover:text-white hover:bg-slate-800/60' %>">
          <i data-lucide="users" class="w-4 h-4 mr-3"></i>
          Suppliers
        </a>
        <a href="/pos/sales" class="flex items-center px-3 py-2.5 text-sm font-medium rounded-lg transition-colors <%= currentPath === '/pos/sales' ? 'bg-slate-800 text-white' : 'text-slate-400 hover:text-white hover:bg-slate-800/60' %>">
          <i data-lucide="receipt" class="w-4 h-4 mr-3"></i>
          Sales Transactions
        </a>

        <div class="pt-4 px-3 pb-2 text-[10px] font-semibold uppercase tracking-wider text-slate-500">Customization & Settings</div>
        <a href="/settings/custom-fields" class="flex items-center px-3 py-2.5 text-sm font-medium rounded-lg transition-colors <%= currentPath === '/settings/custom-fields' ? 'bg-slate-800 text-white' : 'text-slate-400 hover:text-white hover:bg-slate-800/60' %>">
          <i data-lucide="form-input" class="w-4 h-4 mr-3 text-indigo-400"></i>
          Custom Fields
          <span class="ml-auto bg-indigo-500/20 text-indigo-300 text-[10px] font-bold px-2 py-0.5 rounded-full"><%= currentStore.customFields ? currentStore.customFields.length : 0 %></span>
        </a>
        <a href="/settings/categories" class="flex items-center px-3 py-2.5 text-sm font-medium rounded-lg transition-colors <%= currentPath === '/settings/categories' ? 'bg-slate-800 text-white' : 'text-slate-400 hover:text-white hover:bg-slate-800/60' %>">
          <i data-lucide="tag" class="w-4 h-4 mr-3"></i>
          Categories
        </a>
        <a href="/settings/pos" class="flex items-center px-3 py-2.5 text-sm font-medium rounded-lg transition-colors <%= currentPath === '/settings/pos' ? 'bg-slate-800 text-white' : 'text-slate-400 hover:text-white hover:bg-slate-800/60' %>">
          <i data-lucide="tablet" class="w-4 h-4 mr-3 text-emerald-400"></i>
          POS Customizer
        </a>
        <a href="/settings/store" class="flex items-center px-3 py-2.5 text-sm font-medium rounded-lg transition-colors <%= currentPath === '/settings/store' ? 'bg-slate-800 text-white' : 'text-slate-400 hover:text-white hover:bg-slate-800/60' %>">
          <i data-lucide="settings" class="w-4 h-4 mr-3"></i>
          Store Branding
        </a>
      </nav>

      <!-- User Profile & Store Switcher in Bottom Nav -->
      <div class="p-3 border-t border-slate-800 bg-slate-950/40">
        <div class="flex items-center justify-between">
          <div class="flex items-center space-x-3 overflow-hidden">
            <div class="w-8 h-8 rounded-full bg-slate-800 border border-slate-700 flex items-center justify-center text-xs font-semibold text-white">
              <%= currentUser.name.charAt(0) %>
            </div>
            <div class="overflow-hidden">
              <p class="text-xs font-medium text-white truncate"><%= currentUser.name %></p>
              <p class="text-[11px] text-slate-400 capitalize"><%= userRole %></p>
            </div>
          </div>
          <a href="/auth/logout" title="Sign Out" class="p-1.5 text-slate-400 hover:text-red-400 rounded-lg hover:bg-slate-800/60 transition-colors">
            <i data-lucide="log-out" class="w-4 h-4"></i>
          </a>
        </div>
      </div>
    </aside>

    <!-- MAIN CONTENT WRAPPER -->
    <div class="flex-1 flex flex-col min-w-0 overflow-hidden bg-slate-50">
      <!-- TOP NAVIGATION BAR -->
      <header class="h-16 bg-white border-b border-slate-200 flex items-center justify-between px-6 z-10 no-print shadow-xs">
        <!-- Store Switcher Dropdown -->
        <div class="flex items-center space-x-4">
          <div class="relative group">
            <button class="flex items-center space-x-2 px-3 py-1.5 rounded-lg border border-slate-200 bg-slate-50 hover:bg-slate-100 text-xs font-medium text-slate-700 transition shadow-2xs cursor-pointer">
              <span class="w-2.5 h-2.5 rounded-full" style="background-color: <%= brandColor %>;"></span>
              <span class="font-semibold text-slate-900"><%= currentStore.name %></span>
              <i data-lucide="chevrons-up-down" class="w-3.5 h-3.5 text-slate-400"></i>
            </button>
            <!-- Dropdown Menu -->
            <div class="absolute left-0 mt-1 w-64 bg-white rounded-xl shadow-xl border border-slate-100 py-2 hidden group-hover:block hover:block z-50">
              <div class="px-3 py-1 text-[11px] font-semibold text-slate-400 uppercase tracking-wider">Switch Store</div>
              <% if (typeof userStores !== 'undefined' && userStores.length > 0) { %>
                <% userStores.forEach(st => { %>
                  <a href="?switchStore=<%= st._id %>" class="flex items-center justify-between px-3 py-2 text-xs hover:bg-slate-50 transition <%= st._id.toString() === currentStore._id.toString() ? 'bg-slate-50/80 font-bold text-slate-900' : 'text-slate-600' %>">
                    <span class="flex items-center space-x-2">
                      <span class="w-2 h-2 rounded-full" style="background-color: <%= st.brandColor || '#2563eb' %>;"></span>
                      <span class="truncate"><%= st.name %></span>
                    </span>
                    <% if (st._id.toString() === currentStore._id.toString()) { %>
                      <i data-lucide="check" class="w-3.5 h-3.5 text-emerald-600"></i>
                    <% } %>
                  </a>
                <% }) %>
              <% } %>
              <div class="border-t border-slate-100 mt-1 pt-1">
                <a href="/stores/setup" class="flex items-center px-3 py-1.5 text-xs text-brand font-medium hover:bg-slate-50">
                  <i data-lucide="plus" class="w-3.5 h-3.5 mr-1.5"></i>
                  Create New Store
                </a>
              </div>
            </div>
          </div>

          <!-- Currency & Store Tag -->
          <span class="hidden md:inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-600 border border-slate-200">
            Currency: <%= currentStore.currency %> (<%= currentStore.currencyCode %>)
          </span>
          <% if (currentStore.taxRate > 0) { %>
            <span class="hidden md:inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-600 border border-slate-200">
              Tax: <%= currentStore.taxRate %>%
            </span>
          <% } %>
        </div>

        <!-- Quick Action Buttons -->
        <div class="flex items-center space-x-3">
          <a href="/products/new" class="inline-flex items-center px-3 py-1.5 rounded-lg border border-slate-200 text-xs font-medium text-slate-700 bg-white hover:bg-slate-50 shadow-2xs transition">
            <i data-lucide="plus-circle" class="w-4 h-4 mr-1.5 text-slate-500"></i>
            Add Product
          </a>
          <a href="/pos" class="inline-flex items-center px-3.5 py-1.5 rounded-lg text-xs font-medium text-white shadow-sm transition hover:opacity-90" style="background-color: <%= brandColor %>;">
            <i data-lucide="shopping-bag" class="w-4 h-4 mr-1.5"></i>
            Launch POS
          </a>
        </div>
      </header>

      <!-- PAGE CONTENT INJECTION -->
      <main class="flex-1 overflow-y-auto p-6 md:p-8">
        <%- body %>
      </main>
    </div>
  <% } else { %>
    <!-- Guest or Single-page View -->
    <div class="flex-1 flex flex-col min-w-0 bg-slate-50">
      <%- body %>
    </div>
  <% } %>

  <!-- Initialize Lucide Icons -->
  <script>
    lucide.createIcons();
  </script>
</body>
</html>

