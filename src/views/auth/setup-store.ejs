<div class="max-w-2xl mx-auto py-8">
  <div class="mb-6">
    <a href="/dashboard" class="inline-flex items-center text-xs text-slate-500 hover:text-slate-800 mb-2">
      <i data-lucide="arrow-left" class="w-3.5 h-3.5 mr-1"></i>
      Back to Dashboard
    </a>
    <h1 class="text-2xl font-bold text-slate-900">Add New Store</h1>
    <p class="text-slate-500 text-xs mt-0.5">Create an additional store with its own isolated stock, custom fields, and branding.</p>
  </div>

  <div class="bg-white rounded-2xl border border-slate-200/80 shadow-xs p-6">
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="mb-5 p-3 rounded-xl bg-red-50 border border-red-200 text-red-600 text-xs flex items-center">
        <i data-lucide="alert-circle" class="w-4 h-4 mr-2 flex-shrink-0"></i>
        <span><%= error %></span>
      </div>
    <% } %>

    <form action="/stores/setup" method="POST" class="space-y-5">
      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1.5">Store / Business Name *</label>
        <input type="text" name="name" required placeholder="e.g. Metro Electronics or Northside Pharmacy"
          class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition">
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1.5">Store Industry Type & Custom Field Presets *</label>
        <select name="storeType"
          class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 transition">
          <option value="fashion">👗 Fashion & Apparel (Pre-configured with Size, Color, Fabric, Department)</option>
          <option value="grocery">🥦 Grocery & Supermarket (Pre-configured with Expiry Date, Batch #, Weight, Organic)</option>
          <option value="electronics">⚡ Electronics & Gadgets (Pre-configured with Brand, Model, Warranty, Serial #)</option>
          <option value="pharmacy">💊 Pharmacy & Healthcare (Pre-configured with Rx required, Active ingredient, Expiry)</option>
          <option value="hardware">🔧 Hardware & Tools (Pre-configured with Dimensions, Material, Weight)</option>
          <option value="general" selected>📦 General Retail (Standard custom fields)</option>
        </select>
        <p class="text-[11px] text-slate-500 mt-1">This configures custom fields for product tracking. You can add or modify custom fields at any time.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1.5">Currency Symbol</label>
          <select name="currency" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 transition">
            <option value="$" selected>$ (USD / CAD / AUD)</option>
            <option value="£">£ (GBP)</option>
            <option value="€">€ (EUR)</option>
            <option value="₹">₹ (INR)</option>
            <option value="₦">₦ (NGN)</option>
            <option value="¥">¥ (JPY / CNY)</option>
            <option value="R">R (ZAR)</option>
          </select>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1.5">Store Brand Accent Color</label>
          <div class="flex items-center space-x-3">
            <input type="color" name="brandColor" value="#059669"
              class="h-10 w-16 rounded-xl border border-slate-200 cursor-pointer p-0.5">
            <span class="text-xs text-slate-500">Pick color for sidebar accent & receipts</span>
          </div>
        </div>
      </div>

      <div class="pt-4 border-t border-slate-100 flex items-center justify-end space-x-3">
        <a href="/dashboard" class="px-4 py-2 text-xs font-medium text-slate-600 hover:text-slate-800">Cancel</a>
        <button type="submit" class="px-5 py-2.5 rounded-xl bg-slate-900 text-white text-xs font-semibold hover:bg-slate-800 shadow-sm transition">
          Create & Switch to Store
        </button>
      </div>
    </form>
  </div>
</div>

