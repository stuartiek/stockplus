<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-900">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Create Store Account - StockPlus</title>
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="h-full flex items-center justify-center p-4 py-8">
  <div class="max-w-xl w-full">
    <!-- Brand Title -->
    <div class="text-center mb-6">
      <div class="inline-flex items-center justify-center w-12 h-12 rounded-2xl bg-blue-600 text-white font-bold text-xl shadow-xl shadow-blue-500/20 mb-2">
        S+
      </div>
      <h1 class="text-2xl font-bold text-white tracking-tight">Set Up Your Store</h1>
      <p class="text-slate-400 text-xs mt-1">Configure your stock management system tailored to your industry</p>
    </div>

    <!-- Registration Card -->
    <div class="bg-slate-800/90 border border-slate-700/60 rounded-2xl p-7 shadow-2xl backdrop-blur-xl">
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="mb-5 p-3 rounded-xl bg-red-500/10 border border-red-500/20 text-red-400 text-xs flex items-center">
          <i data-lucide="alert-circle" class="w-4 h-4 mr-2 flex-shrink-0"></i>
          <span><%= error %></span>
        </div>
      <% } %>

      <form action="/auth/register" method="POST" class="space-y-5">
        <!-- Section: Account Info -->
        <div>
          <h3 class="text-xs font-semibold uppercase tracking-wider text-blue-400 mb-3 flex items-center">
            <i data-lucide="user" class="w-3.5 h-3.5 mr-1.5"></i>
            1. Account Owner Details
          </h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-medium text-slate-300 mb-1">Your Full Name *</label>
              <input type="text" name="name" required placeholder="Alex Morgan" value="<%= typeof data !== 'undefined' && data.name ? data.name : '' %>"
                class="w-full px-3.5 py-2 rounded-xl bg-slate-900/80 border border-slate-700 text-white placeholder-slate-500 text-xs focus:outline-none focus:border-blue-500 transition">
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-300 mb-1">Email Address *</label>
              <input type="email" name="email" required placeholder="alex@mystore.com" value="<%= typeof data !== 'undefined' && data.email ? data.email : '' %>"
                class="w-full px-3.5 py-2 rounded-xl bg-slate-900/80 border border-slate-700 text-white placeholder-slate-500 text-xs focus:outline-none focus:border-blue-500 transition">
            </div>
            <div class="md:col-span-2">
              <label class="block text-xs font-medium text-slate-300 mb-1">Password * (min 6 characters)</label>
              <input type="password" name="password" minlength="6" required placeholder="••••••••"
                class="w-full px-3.5 py-2 rounded-xl bg-slate-900/80 border border-slate-700 text-white placeholder-slate-500 text-xs focus:outline-none focus:border-blue-500 transition">
            </div>
          </div>
        </div>

        <div class="border-t border-slate-700/60 pt-4">
          <h3 class="text-xs font-semibold uppercase tracking-wider text-blue-400 mb-3 flex items-center">
            <i data-lucide="store" class="w-3.5 h-3.5 mr-1.5"></i>
            2. First Store Setup
          </h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
            <div class="md:col-span-2">
              <label class="block text-xs font-medium text-slate-300 mb-1">Store / Business Name *</label>
              <input type="text" name="storeName" required placeholder="e.g. Apex Boutique or GreenLeaf Market" value="<%= typeof data !== 'undefined' && data.storeName ? data.storeName : '' %>"
                class="w-full px-3.5 py-2 rounded-xl bg-slate-900/80 border border-slate-700 text-white placeholder-slate-500 text-xs focus:outline-none focus:border-blue-500 transition">
            </div>

            <!-- Store Type Customizer -->
            <div class="md:col-span-2">
              <label class="block text-xs font-medium text-slate-300 mb-1">
                Store Type & Custom Field Preset *
              </label>
              <select name="storeType" id="storeTypeSelect"
                class="w-full px-3.5 py-2 rounded-xl bg-slate-900/80 border border-slate-700 text-white text-xs focus:outline-none focus:border-blue-500 transition">
                <option value="fashion">👗 Fashion & Apparel (Includes Size, Color, Fabric, Department)</option>
                <option value="grocery">🥦 Grocery & Supermarket (Includes Expiry Date, Batch #, Weight, Organic)</option>
                <option value="electronics">⚡ Electronics & Gadgets (Includes Brand, Model, Warranty, Serial #)</option>
                <option value="pharmacy">💊 Pharmacy & Healthcare (Includes Rx required, Active ingredient, Expiry)</option>
                <option value="hardware">🔧 Hardware & Construction (Includes Dimensions, Material, Weight)</option>
                <option value="general" selected>📦 General Retail (Standard custom fields)</option>
              </select>
              <p class="text-[11px] text-slate-400 mt-1">
                💡 Automatically initializes customizable fields matching your store type. You can edit or add more anytime!
              </p>
            </div>

            <div>
              <label class="block text-xs font-medium text-slate-300 mb-1">Currency Symbol</label>
              <select name="currency" class="w-full px-3.5 py-2 rounded-xl bg-slate-900/80 border border-slate-700 text-white text-xs focus:outline-none focus:border-blue-500 transition">
                <option value="$" selected>$ (USD / CAD / AUD)</option>
                <option value="£">£ (GBP)</option>
                <option value="€">€ (EUR)</option>
                <option value="₹">₹ (INR)</option>
                <option value="₦">₦ (NGN)</option>
                <option value="¥">¥ (JPY / CNY)</option>
                <option value="R">R (ZAR)</option>
              </select>
            </div>

            <div>
              <label class="block text-xs font-medium text-slate-300 mb-1">Brand Theme Color</label>
              <div class="flex items-center space-x-2">
                <input type="color" name="brandColor" value="#2563eb"
                  class="h-8 w-12 rounded-lg bg-transparent border border-slate-700 cursor-pointer">
                <span class="text-[11px] text-slate-400">Custom UI & receipt color</span>
              </div>
            </div>
          </div>
        </div>

        <button type="submit" class="w-full py-2.5 px-4 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-medium text-sm transition shadow-lg shadow-blue-600/30 flex items-center justify-center cursor-pointer mt-4">
          <i data-lucide="check-circle" class="w-4 h-4 mr-2"></i>
          <span>Create Account & Launch Store</span>
        </button>
      </form>
    </div>

    <p class="text-center text-xs text-slate-400 mt-5">
      Already have an account? 
      <a href="/auth/login" class="text-blue-400 hover:text-blue-300 font-medium ml-1">Sign in here</a>
    </p>
  </div>

  <script>lucide.createIcons();</script>
</body>
</html>

